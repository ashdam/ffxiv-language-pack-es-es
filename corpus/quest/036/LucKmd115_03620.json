{
  "conversation": "quest/036/LucKmd115_03620",
  "gameVersion": "2026.08.11.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_SEQ_00", "hash": "39666F40D926930C", "target": "La mirada de Minfilia es, a partes iguales, de inquietud y de determinación." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_00", "hash": "B5308555418FFFF8", "target": "Inspeccionar el lugar indicado" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_01", "hash": "A5C84C567FE62429", "target": "Buscar a Minfilia" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_TODO_02", "hash": "838274F23593FE96", "target": "Buscar a Thancred" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_000", "hash": "98FAB62BF47CF33F", "target": "Puedo sentir su presencia, aunque débilmente." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_001", "hash": "14BB5ED3DC446C07", "target": "Vamos, busquemos junto a la pared de cristal." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_010", "hash": "B043A9C82585C2F3", "target": "Estuvo aquí. En lo alto de este edificio..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_020", "hash": "01F8AFBF7774509E", "target": "\\<quejido>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_021", "hash": "1F98560B1F8E0DE8", "target": "¿Qué ha pasado? Recuerdo estar hablando con Minfilia... y luego..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_022", "hash": "C4CB2D099EA55F50", "target": "¿Ocurre algo?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q1_000_000", "hash": "A29250F2F5F49059", "target": "¿Qué vas a decir?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_001", "hash": "C1ED64E72EA447DA", "target": "Tu pelo ha cambiado." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A1_000_002", "hash": "8D0C20CBF9CB5461", "target": "Tus ojos han cambiado." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_023", "hash": "1EF3A43F9F893B03", "target": "Un regalo de despedida, creo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_024", "hash": "85C24CD3785579BD", "target": "Hasta ahora he recorrido el camino que ella trazó ante mí. El camino que trazó ante todas las Minfilias." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_025", "hash": "E316E0C81CC89833", "target": "Pero me ha dado un nuevo camino, una nueva vida, que puedo llamar mía." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_026", "hash": "B8900FEA1214D900", "target": "Y aunque se ha ido, todavía puedo sentirla... cálida, serena y dulce." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_027", "hash": "290EA0F2689BE40F", "target": "Puedo sentir el corazón palpitante del mundo, la Luz que se hincha en su interior." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_028", "hash": "119683F8E011AC88", "target": "Y los Guardianes de la Luz. Hay uno aquí, en Amh Araeng." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_029", "hash": "B664EE7BF1B57A83", "target": "Volvamos deprisa. Los demás tienen que saberlo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_030", "hash": "E0DFBC485C27CBC5", "target": "No creerás que Thancred se enfadará conmigo, ¿verdad?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_Q2_000_000", "hash": "00AF7D3842898CBA", "target": "¿Qué vas a decir?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_001", "hash": "31211EC39D6F8800", "target": "Es lo que quería Minfilia. Seguro que lo entenderá." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_A2_000_002", "hash": "B8D1C6957F02170B", "target": "Solo hay una forma de averiguarlo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_031", "hash": "142401DF331E0FC1", "target": "Me gustaría pensar lo mismo, pero... \\<suspiro>" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_032", "hash": "88D4673C52E9C2B9", "target": "\\<suspiro> Sé que no hay forma de evitarlo, pero..." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_033", "hash": "94BD0BE3B3AB640A", "target": "¿Te importaría adelantarte? Voy justo detrás de ti. Te lo prometo." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_RYNE_000_035", "hash": "6B05FE4D20CC5770", "target": "Solo... necesito un momento para pensar." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALPHINAUD_000_040", "hash": "E7F7061234CE8853", "target": "¡Habéis vuelto! Empezábamos a preocuparnos por vosotros." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_ALISAIE_000_045", "hash": "24D669121428A4AE", "target": "¡<split(<string(gstr1)>, ,1)>! Gracias a los dioses que estás bien." },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_URIANGER_000_050", "hash": "9E218EED8FA0C288", "target": "Has vuelto. Mas ¿dónde está Minfilia?" },
    { "gameKey": "quest/036/LucKmd115_03620#TEXT_LUCKMD115_03620_YSHTOLA_000_055", "hash": "7170DDC2E2315F22", "target": "Bienvenido de vuelta. Veo que te ha ido mejor que a Thancred." }
  ]
}
