{
  "conversation": "quest/036/LucKmd102_03607",
  "gameVersion": "2026.08.11.0000.0000",
  "entries": [
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_SEQ_00", "hash": "DDDCD3D40B33B28A", "target": "Alisaie contempla todo lo que aún queda por hacer tras la batalla." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_TODO_00", "hash": "FF17744E08146D63", "target": "Auxiliar a los heridos" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_TODO_01", "hash": "B9D37C7317C9792B", "target": "Hablar con Lyna" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALPHINAUD_000_000", "hash": "60F182438EB6A1C7", "target": "Aguanta solo un momento más..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_URIANGER_000_005", "hash": "367B1AEA09249DE9", "target": "No has de moverte." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_YSHTOLA_000_010", "hash": "CB523C49CE442E18", "target": "Respira hondo por mí. Eso es..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_020", "hash": "1337C1198EEC75A2", "target": "Los demás están ayudando a atender a los heridos. Yo pienso echar una mano con el traslado, pero, aun así, sencillamente no damos abasto." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_021", "hash": "F26B8C5788EF2D42", "target": "Seguro que ya no te tienes en pie tras lo que hemos pasado (bien saben los dioses que yo tampoco), pero, si pudieras ocuparte de algunos pacientes, sería una ayuda enorme." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_022", "hash": "4983B767A78D6DFD", "target": "La capitana Lyna anda por aquí, así que podrías preguntarle también si hay más zonas que necesiten ayuda. Ya hablaremos luego." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_ALISAIE_000_025", "hash": "1C468D0DE6630F19", "target": "Aguante un poco. Irá en el próximo carruaje de vuelta al Cristarium, se lo prometo..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDA03607_000_030", "hash": "EB6F2FCF9022210E", "target": "Yo... yo... \\<resuello>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_SYSTEM_000_031", "hash": "09142A9F9078E5B2", "target": "Con los ojos anegados en lágrimas, el hombre postrado alza la vista hacia ti. Sus dedos se crispan, como si quisieran alcanzarte, pero le faltan fuerzas para levantar la mano." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDA03607_000_032", "hash": "026A21514A7A64BA", "target": "..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_033", "hash": "A430C1BBAC1DE870", "target": "G-gracias, pero... es demasiado tarde." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_034", "hash": "764BD42B13DA9DF9", "target": "Uno de ellos... me alcanzó. \\<tos>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_035", "hash": "079E3225D8C46368", "target": "Si me transformo, por favor... Por favor, máteme, se lo suplico." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDB03607_000_036", "hash": "DC5F40A8FD07D383", "target": "Lo... lo siento mucho." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_037", "hash": "2E5A4AB19938951D", "target": "¡No me toque! Yo... yo..." },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_038", "hash": "1627F30323FC3176", "target": "La he matado... ¡La he matado! Era uno de ellos, lo sé, pero yo... \\<sollozo>" },
    { "gameKey": "quest/036/LucKmd102_03607#TEXT_LUCKMD102_03607_INJUREDC03607_000_039", "hash": "34C4519D9106702C", "target": "Quizá me lo merezca... Pero <italic(1)>ella<italic(0)>..." }
  ]
}
