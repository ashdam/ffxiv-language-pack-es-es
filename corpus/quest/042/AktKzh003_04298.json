{
  "conversation": "quest/042/AktKzh003_04298",
  "gameVersion": "2026.09.01.0000.0000",
  "entries": [
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_SEQ_00", "hash": "496E6C6F841F82CC", "target": "<colortype(508)><edgecolortype(509)> Sincronización de misión<edgecolortype(0)><colortype(0)><br>El colega del observador sereno lleva demasiado tiempo ausente." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_00", "hash": "69339135B9F7B01F", "target": "Hablar con el observador de Thalassai" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_01", "hash": "6DF6B5CDB3A64E3E", "target": "Alimentar a los Zephyros 72" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_02", "hash": "D224459EEB652FB6", "target": "Llevar los Zephyros 72 al observador de Thalassai" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_TODO_03", "hash": "D7760AB601EFB269", "target": "Hablar con el observador de Thalassai" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_000", "hash": "3DEBAC09B7C261E2", "target": "¿Puedo pedirte un favor? Un colega mío de Thalassai lleva ya un retraso con su informe, y necesito que alguien le dé un empujoncito amable." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_001", "hash": "4A21DACAE9F47D96", "target": "Ahora mismo está en el Paseo de la Reflexión, observando unas formas de vida recién eclosionadas de una de nuestras creaciones, pero me temo que falsearé los datos si aparezco y las asusto." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_002", "hash": "86392E3DDEC8E887", "target": "Un familiar como tú, en cambio, causaría muchas menos molestias. ¿Serías tan amable...?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_003", "hash": "41EAA6896D07D9DE", "target": "Encontrarás a mi colega en el Paseo de la Reflexión." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEA04298_100_001", "hash": "F9EB9CAC8698E448", "target": "\\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEB04298_100_002", "hash": "88056B9D7CAED8AD", "target": "\\<frufrú> ...?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEC04298_100_003", "hash": "94A5200B91E37971", "target": "\\<frufrú> \\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILED04298_100_004", "hash": "C725F749203CEBFB", "target": "\\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_004", "hash": "2A9F571C8688B8C8", "target": "¿Un familiar? ¿Puedo ayudarte en algo?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_005", "hash": "3EA79F3B49CCE862", "target": "Ah, ¿que ya toca volver? Estaba tan absorto viendo retozar a las crías que perdí la noción del tiempo." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_006", "hash": "5432E9271E361FAB", "target": "¡Vamos, vamos, todos! ¡Tenemos que irnos ya!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_007", "hash": "875F42AC10A1130E", "target": "\\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_008", "hash": "B1C8FC143772BF55", "target": "¿Que todavía queréis jugar? ¡Entonces habrá que apelar a vuestras barriguitas!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_009", "hash": "E23D52B11BCA3032", "target": "¿Te gustaría intentar darles de comer?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_010", "hash": "4E91437CDF273E3D", "target": "Se vuelven mucho más dóciles después de comer algunas de estas golosinas. ¡Y qué adorables son cuando mordisquean!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_011", "hash": "66DC8AE699863255", "target": "Adelante, dales algunas golosinas." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEA04298_000_013", "hash": "CCE92DA2253EFD15", "target": "\\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEA04298_000_014", "hash": "2526E3C552FBC6D1", "target": "\\<frufrú> \\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEB04298_000_015", "hash": "B0A406E62A0AA480", "target": "\\<frufrú> ...?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEB04298_000_016", "hash": "933FE6FF9EB8E90F", "target": "\\<frufrú> \\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEC04298_000_017", "hash": "89A9CAE82C770FA3", "target": "\\<frufrú> ..." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILEC04298_000_018", "hash": "906DB950652B7D8F", "target": "\\<frufrú> \\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILED04298_000_019", "hash": "165A00AEB4C47038", "target": "\\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_JUVENILED04298_000_020", "hash": "CAFD7EAD20738C76", "target": "\\<frufrú> \\<frufrú>" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_021", "hash": "2511DF47594EFDFD", "target": "¿A que es divertido verlos corretear?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_022", "hash": "1261CDC68AC48140", "target": "¡Y parece que les has caído muy bien! ¿Trabajas a menudo con crías?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_023", "hash": "F2CDC643184740DF", "target": "Estos pequeños son criaturas acuáticas por naturaleza, pero los estamos modificando para que se adapten a la vida en tierra firme." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_024", "hash": "215F5F63CDA810F0", "target": "Comen sobre todo insectos marinos y mariscos, y a su vez algunos de los carnívoros más grandes se alimentan de ellos." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_025", "hash": "1EDE0182F8693F90", "target": "También llevan los huevos a la espalda hasta que están listos para eclosionar. Fascinantes, ¿verdad?" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_026", "hash": "9E0DA2B04C0487E2", "target": "¡Ah, pero no es por eso por lo que has venido! ¡Tengo que volver ya!" },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_027", "hash": "F48B8CECB8F532CC", "target": "Gracias por ir a buscar a mi colega." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_028", "hash": "EF95E8EFA741D64A", "target": "Si no te hubieran mandado a buscarme, podría haberme quedado allí días enteros." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERB04298_000_029", "hash": "57C5380D6DDDFA14", "target": "En cualquier caso, es solo cuestión de tiempo que nuestras creaciones sean aprobadas para soltarlas en la naturaleza. Me pregunto qué nombre recibirán..." },
    { "gameKey": "quest/042/AktKzh003_04298#TEXT_AKTKZH003_04298_OBSERVERA04298_000_030", "hash": "398BD7435BCEA504", "target": "Gracias por toda tu ayuda de hoy. Toma, en agradecimiento." }
  ]
}
