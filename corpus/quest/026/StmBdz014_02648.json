{
  "conversation": "quest/026/StmBdz014_02648",
  "gameVersion": "2026.09.01.0000.0000",
  "entries": [
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_SEQ_00", "hash": "348063527F7E4E9E", "target": "Este hombre encantador está bastante alterado." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_TODO_00", "hash": "2178DFCC742EAF57", "target": "Abatir al oso que ataca al hombre temerario" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_TODO_01", "hash": "E1760B07F2D6690D", "target": "Rescatar al hombre temerario" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_TODO_02", "hash": "0823748C3E8DCE09", "target": "Informar al hombre alterado" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_000", "hash": "89CF80EF149A5397", "target": "¡Eh, tú! Por favor, ayuda a mi amigo. ¡Le ha atacado un oso!" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_001", "hash": "2DC913FCDDD2D054", "target": "Lo encontrarás al oeste de aquí." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_003", "hash": "A4C5DC1047A3A758", "target": "Encontrarás a mi amigo al oeste de aquí." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_010", "hash": "283D5ED42F6AFFD0", "target": "¿Está a salvo mi amigo?" },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PINCHMAN02648_000_010", "hash": "3436158DC060F90B", "target": "Ha estado demasiado cerca para mi gusto. Gracias por salvarme." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PINCHMAN02648_000_011", "hash": "B36865BECE5A2A9D", "target": "¿Te pidió ayuda mi amigo? ¿Podrías volver y decirle que estoy a salvo? Necesito recuperar el aliento antes de moverme de aquí." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PINCHMAN02648_000_020", "hash": "B75E03DB3A8B1044", "target": "Vuelve, por favor, y dile a mi amigo que estoy a salvo." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_030", "hash": "13FD4FDCB723B07D", "target": "¿Está a salvo? Uf, no podría estar más aliviado. A menudo no nos queda más remedio que aventurarnos fuera del pueblo en busca de plantas silvestres." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_031", "hash": "224E03134AD99F1E", "target": "Ojalá la maldita tierra que pisamos fuera más generosa. Nunca tendríamos que ponernos en semejante peligro." },
    { "gameKey": "quest/026/StmBdz014_02648#TEXT_STMBDZ014_02648_PANICMAN02648_000_032", "hash": "B6F61745A9FE88E3", "target": "En fin, lo único que importa es que mi amigo está a salvo. Gracias." }
  ]
}
