{
  "conversation": "quest/025/StmBda402_02501",
  "gameVersion": "2026.08.11.0000.0000",
  "entries": [
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_SEQ_00", "hash": "90DD2998F3844688", "target": "Cirina no suele depender de la amabilidad de desconocidos, pero hoy hará una excepción con gusto." },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_TODO_00", "hash": "B58CFC123A40D19C", "target": "Abatir dholes y obtener whisperroot" },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_TODO_01", "hash": "26FD30F5CC08DA0E", "target": "Entregar el whisperroot a Cirina" },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_CIRINA_000_010", "hash": "B9DB6FB06838CC60", "target": "¿Us... usted quiere ayudarme, es eso?" },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_CIRINA_000_011", "hash": "9C1B28205C18DAF7", "target": "No sé qué decir... ¡Gracias, <split(<string(gstr1)>, ,1)>, gracias!" },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_CIRINA_000_012", "hash": "C3E0A8B46751D632", "target": "Las criaturas que debemos abatir vagan por las llanuras al oeste de Reunion. Si cada uno recoge dos, deberíamos tener whisperroot suficiente." },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_CIRINA_000_013", "hash": "DC62C6B6B2B872DB", "target": "Vuelva aquí cuando haya terminado. ¡Buena suerte!" },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_CIRINA_000_020", "hash": "C41B3B48EF34B57A", "target": "Ya está de vuelta, <split(<string(gstr1)>, ,1)>. ¿Ha traído el whisperroot?" },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_CIRINA_000_021", "hash": "E6939C48E5F5688D", "target": "Bendito sea quien muestra bondad a los desconocidos, pues la fortuna cabalga siempre a su lado." },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_CIRINA_000_022", "hash": "E68D24038F240A68", "target": "¿Bastará con esta cantidad?" },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_MASGUD_000_023", "hash": "2770EA3C41E27CE9", "target": "Bastará. El kinsai es tuyo." },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_MASGUD_000_024", "hash": "1D98D3DFFC070454", "target": "Los dioses te favorecen más de lo que crees, niña. Los Udgan rara vez necesitan hierbas así, de modo que mis existencias son limitadas. Si hubieras venido un día antes o después, no me habría quedado ninguna para ti." },
    { "gameKey": "quest/025/StmBda402_02501#TEXT_STMBDA402_02501_CIRINA_000_025", "hash": "C3B30788B4523263", "target": "Quizá los dioses me guiaron hasta aquí, como guiaron a la Abuela. Como guiaron a <if(gnum4,esta mujer,este hombre)> del Oeste..." }
  ]
}
