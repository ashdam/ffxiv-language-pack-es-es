{
  "conversation": "quest/049/KinGmf113_04958",
  "questName": "A Journey Never-ending",
  "gameVersion": "2026.09.01.0000.0000",
  "entries": [
    { "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_SEQ_00", "hash": "A556D37262F017FA", "target": "Cahciua está lista para surcar el cielo a lomos de un mehwapyarra." },
    { "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_TODO_00", "hash": "6F6BC3036A856432", "target": "Hablar con el conservador del museo" },
    { "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_TODO_01", "hash": "CFBCD465DA7F1125", "target": "Hablar con Erenville" },
    { "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_TODO_02", "hash": "54D202E8D192F20A", "target": "Hablar con Cahciua" },
    { "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_TODO_03", "hash": "EFB3DA49E2A9E373", "target": "Hablar con Wuk Lamat" },
    { "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_TODO_04", "hash": "4BE74EB727010AA1", "target": "Volver a hablar con Wuk Lamat" },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_001",
      "hash": "40968DEB5214633D",
      "target": "Sé que no hay que juzgar por las apariencias, pero aun así..."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CLEYRACURATOR_000_005",
      "hash": "B0DAF59DDEB29859",
      "target": "¡Hola! ¿Vienen a montar en los mehwapyarras?"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_010",
      "hash": "06FB172E69655D9D",
      "target": "Disculpe, aquí es donde se pueden hacer los vuelos turísticos, ¿verdad?"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CLEYRACURATOR_000_011",
      "hash": "D75AD288A40C03FD",
      "target": "¡Así es! Los llevarán nuestros adorables mehwapyarras, adiestrados especialmente por un amigo de Tural."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CLEYRACURATOR_000_012",
      "hash": "EC36D618B8D1588B",
      "target": "¡Solo tienen que decirlo y los mandamos arriba, arriba y a volar!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_013",
      "hash": "5F2F067606B260A9",
      "target": "¡Ahí lo tienes! ¿Vamos, entonces?"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_015",
      "hash": "D828B7A0D1B14063",
      "target": "Parece que tendré que fiarme de la teoría de la predisposición levitatoria ancestral..."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_020",
      "hash": "04694B49265F1BF5",
      "target": "Por si no la conocéis, la teoría sostiene que toda forma de vida posee una capacidad innata para la magia de levitación. Aunque esa magia suele permanecer latente, puede manifestarse en la facultad de volar."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_025",
      "hash": "A46AF0322988CF40",
      "target": "Yo apuesto a que los mehwapyarras no vuelan por sí mismos, sino que sus monturas están imbuidas de magia de levitación."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CLEYRACURATOR_000_030",
      "hash": "4B81302FDF4C2740",
      "target": "¿Están listos? Pues adelante, súbanse. Los mehwapyarras siguen una ruta fija, ¡así que solo tienen que relajarse y disfrutar de las vistas!"
    },
    { "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_SYSTEM_000_031", "hash": "CDBAC082E2D0CAA4", "target": "¿Montar en el mehwapyarra?" },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_032",
      "hash": "D5ED00D4B78186FE",
      "target": "¡Ja, ja, ja! ¡Qué subidón!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_033",
      "hash": "9BD0B5C4109BCD6E",
      "target": "Que me aspen... De verdad que vuelan..."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_034",
      "hash": "485B061AD2C6F6FF",
      "target": "Oye, volando así en formación, ¿no parecemos aves migratorias?"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_035",
      "hash": "90472BA456800588",
      "target": "Salvo que vamos montados en roedores gigantes..."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_036",
      "hash": "8679DDAB6F16E491",
      "target": "Hablando de aves migratorias, tu nombre viene del ánade real. ¿Te lo llegué a contar?"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_037",
      "hash": "0BCF886DA2D30366",
      "target": "Eso ya lo sabía, pero me lo dijo la chamana, no tú."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_038",
      "hash": "B59244BA8F444082",
      "target": "Un ave migratoria puede volar adonde quiera─incluso cruzar océanos hasta continentes lejanos."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_039",
      "hash": "66E89F1C2BD55AC5",
      "target": "¡Y eso es justo lo que has hecho, mi ánade listillo!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_040",
      "hash": "1606D6A7F5759079",
      "target": "¡Te agradecería que no me llamaras así!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_041",
      "hash": "AD3CE68DE8FF003D",
      "target": "Vaya, ¿ya se ha acabado? ¡El tiempo <italic(1)>vuela<italic(0)> cuando uno se divierte!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_042",
      "hash": "DC880526857EBB38",
      "target": "¡Qué gozada ver la Memoria Viva desde las alturas!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_043",
      "hash": "29562E0509C68F28",
      "target": "..."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_044",
      "hash": "F3805279B8E62419",
      "target": "Ahhh, ¡ha sido maravilloso! ¡Una experiencia que merecía guardarse para el final!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_045",
      "hash": "6F13FF5C07FD6EAB",
      "target": "Vosotros dos también lo habéis disfrutado, ¿no?"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_046",
      "hash": "C9AE7CD9652CD88B",
      "target": "Ha estado bastante bien, supongo."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_047",
      "hash": "621EB1B4D5A1787E",
      "target": "Viniendo de mi conejito quisquilloso, eso es un elogio enorme. Me alegro de haberos invitado a ti y a <split(<string(gstr1)>, ,1)>."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_048",
      "hash": "223168E9E427CFB8",
      "target": "Gracias por seguirme la corriente."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_049",
      "hash": "D4806BD399D10647",
      "target": "..."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_050",
      "hash": "C8B57D53BF3527B8",
      "target": "Si pudiera, daría otras cien vueltas, pero tendré que conformarme con una."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_051",
      "hash": "328195190FE7F237",
      "target": "Ya va siendo hora de ir al Aeroterminal. Si aún os queda algo por hacer, este es el momento."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_052",
      "hash": "D19F510070D5DFFF",
      "target": "Cuando estéis listos, seguid el sendero de allí. Yo buscaré a los demás y les diré lo mismo."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CLEYRACURATOR_000_055",
      "hash": "919719368AF3D82F",
      "target": "¡Vuelvan a volar con nosotros cuando quieran!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_060",
      "hash": "9399EEA67D5CD52D",
      "target": "No es más que una copia construida a partir de sus recuerdos. Lo entiendo."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_061",
      "hash": "B42FEC5366FE3803",
      "target": "Pero, cuando la tengo ahí delante, tan viva y tan animada como siempre la he conocido, ¿cómo se supone que voy a hacerlo? ¿Cómo se supone que voy a borrarla?"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_062",
      "hash": "813B4B21C5EA171C",
      "target": "¿Se hace siquiera una idea de cómo me destroza esto?"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_065",
      "hash": "A5E5DB185D8C2245",
      "target": "No es justo..."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_WUKLAMAT_000_070",
      "hash": "D43CB865CEC3C8C4",
      "target": "Os vimos desde abajo. Parecía que os lo estabais pasando bien."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_KRILE_000_075",
      "hash": "7CFE09BCEF340170",
      "target": "Será duro, pero despidamos a Cahciua con una sonrisa."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_GRAHATIA_000_080",
      "hash": "6707968FEC38D60F",
      "target": "Estaremos ahí para Erenville."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_090",
      "hash": "B5D89F527D93163B",
      "target": "No podría haber pedido unas últimas horas más plenas que estas."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_095",
      "hash": "3B778B2E885AB253",
      "target": "Me alegro muchísimo de haberte conocido, <split(<string(gstr1)>, ,1)>. A ti y a todos. Gracias por los recuerdos."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_CAHCIUA_000_100",
      "hash": "C06DF758E889C94D",
      "target": "Y gracias por cuidar de mi Elene'shpya. Ahora estará bien, lo sé."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_105",
      "hash": "CB0B35BD2ADCCD7B",
      "target": "Se acabaron las dudas. Yo apagaré el terminal."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_KRILE_000_110",
      "hash": "56F19CE339E1C6E0",
      "target": "Llevemos nuestra tarea hasta el final."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_GRAHATIA_000_115",
      "hash": "425109EEDA3D05DB",
      "target": "Seguimos adelante, con sus esperanzas y sus recuerdos en el corazón."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_WUKLAMAT_000_120",
      "hash": "EA715B127274F0DE",
      "target": "Te lo dejamos a ti, Erenville."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_121",
      "hash": "9316DEF9AD66AE54",
      "target": "Sí, no vacilaré. Ya no."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_122",
      "hash": "40171D28099D5AD7",
      "target": "Si vosotros estáis listos, yo también."
    },
    { "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_SYSTEM_000_123", "hash": "33CF95626871749B", "target": "Una vez apagado el Aeroterminal, no será posible devolver los Jardines de Sendaviento a su forma actual." },
    { "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_SYSTEM_000_124", "hash": "39AD09A298FBE5BF", "target": "¿Seguro que quieres apagar el terminal?" },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_GRAHATIA_000_125",
      "hash": "090E87C55AE7F0FD",
      "target": "¡Acabemos con esto!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_KRILE_000_130",
      "hash": "8F0004030DF22A83",
      "target": "¡No dejaremos que las esperanzas de Cahciua sean en vano!"
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_ERENVILLE_000_135",
      "hash": "325C9073A58510D6",
      "target": "No hay tiempo para lágrimas... Mejor así."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_WUKLAMAT_000_140",
      "hash": "BE4351B7398BCDD4",
      "target": "Justo a tiempo... Es como si dijera que ya no va a dejarnos hacer lo que nos plazca."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_WUKLAMAT_000_141",
      "hash": "777439740DCCF722",
      "target": "Con el tiempo que hemos pasado aquí, hemos llegado a saber qué es lo que Sphene quiere proteger."
    },
    {
      "gameKey": "quest/049/KinGmf113_04958#TEXT_KINGMF113_04958_WUKLAMAT_000_142",
      "hash": "AF1850E9C119244E",
      "target": "¡Pero eso no cambia lo que tenemos que hacer!"
    }
  ]
}
