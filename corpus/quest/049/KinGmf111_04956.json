{
  "conversation": "quest/049/KinGmf111_04956",
  "questName": "An Explorer's Delight",
  "gameVersion": "2026.08.11.0000.0000",
  "entries": [
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_SEQ_00", "hash": "2B7EDB5B53C7C640", "target": "Cahciua está lista para dirigirse a la cuarta y última zona." },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_TODO_00", "hash": "CC4EBC2C6F486B38", "target": "Hablar con Cahciua" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_TODO_01", "hash": "AF820A5337C39282", "target": "Hablar con el guardia de los Jardines de Sendaviento" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_TODO_02", "hash": "F56F0226CB2BE7EC", "target": "Hablar con Cahciua" },
    { "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_TODO_03", "hash": "233EF108B074E5AA", "target": "Volver a hablar con Cahciua" },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_001",
      "hash": "4C5664E681805AA5",
      "target": "La próxima vez nos tocará despedirnos de..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_005",
      "hash": "F65ED5622A59AA5B",
      "target": "Solo queda una zona..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_010",
      "hash": "BD17F0A423572E4C",
      "target": "Puede que sus recuerdos hayan desaparecido, pero su amor estará conmigo siempre..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_015",
      "hash": "D84AA1CEC5ECC8E2",
      "target": "..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_020",
      "hash": "9E19EDE339F45A44",
      "target": "He de decir que, cuanto más nos acercamos al final, más deprisa parece pasar el tiempo."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_021",
      "hash": "BDB60F019487BCDE",
      "target": "Venga, vayamos a la cuarta y última zona. A estas alturas ya sabéis cómo llegar, ¿no?"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_022",
      "hash": "21A4DF58C8CE692C",
      "target": "Sí, lo sabemos."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_023",
      "hash": "B529F150F7F49070",
      "target": "Estupendo. Esta vez quiero echarle un vistazo rápido al Meso Terminal, así que nos vemos en la Puerta del Recuerdo."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_024",
      "hash": "9BAA35407AAC8C20",
      "target": "Vamos, chicos..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_025",
      "hash": "50FA34D918A7542F",
      "target": "Ay, Erenville..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_030",
      "hash": "5DC78916AA23A131",
      "target": "Así que ha llegado el momento..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_035",
      "hash": "C80EC3E53364191F",
      "target": "Como antes, será duro, pero debemos honrar el deseo de Cahciua."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_040",
      "hash": "65D65D008607E196",
      "target": "..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_050",
      "hash": "2A4B27894AE7C9A8",
      "target": "Por lo que puedo ver, todavía tenemos algo de margen con el Meso Terminal."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_051",
      "hash": "B95C63C139A31F8E",
      "target": "O sea, que podéis seguir conociendo a los Perpetuos de la última zona."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_052",
      "hash": "DAC65FBF19318E9C",
      "target": "Se llama los Jardines de Sendaviento, ¡y son de una belleza que quita el aliento!"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_053",
      "hash": "6C4E17F3CB4B9709",
      "target": "Ahí es donde están guardados tus recuerdos, ¿verdad?"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_054",
      "hash": "2DD57BBBF7375CAA",
      "target": "Así es. Lo dejé para el final para poder guiaros el mayor tiempo posible. Qué considerada soy, ¿verdad?"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_055",
      "hash": "F5BC05059B22D174",
      "target": "¡Oh! ¡Se me acaba de ocurrir una idea genial!"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_056",
      "hash": "CAB344B15567AF6E",
      "target": "¿Y cuál es?"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_057",
      "hash": "B4F12E5220138DB2",
      "target": "\\<risita> Me la guardo para cuando lleguemos al otro lado. ¡Nos vemos allí!"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_058",
      "hash": "90E6569D7F3DCBE8",
      "target": "Sus “ideas geniales” no suelen tener nada de geniales."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_059",
      "hash": "145E1C54D98C7923",
      "target": "Oye, Erenville..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_060",
      "hash": "9EE933D9ECD926D6",
      "target": "Por mucho que quiera cumplir el deseo de tu madre, también quiero respetar el tuyo."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_061",
      "hash": "014BF3A1B44747EC",
      "target": "Cuando todo esto acabe, quiero que estés bien. Espero que lo sepas."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_062",
      "hash": "5F4242CA2AA22D22",
      "target": "Lo sé."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_063",
      "hash": "DB8AEAF9F6BEA1D2",
      "target": "Lo sé..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_064",
      "hash": "A74834BA67D3997E",
      "target": "Cahciua no es solo su madre─también es su maestra. Eso solo puede hacerle más difícil despedirse."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_065",
      "hash": "81A224AD8F9D39D8",
      "target": "Vamos. Por ahora seguimos con lo mismo: buscar Perpetuos y descubrir qué les importa."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_070",
      "hash": "CA33B31264452D02",
      "target": "No hagamos esperar a Cahciua."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_075",
      "hash": "37B9F37D2C8CDA9F",
      "target": "Tengo fe en la fortaleza interior de Erenville."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_080",
      "hash": "AEFEF9752F8F0292",
      "target": "¿Cuál será esa idea genial de Cahciua?"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_085",
      "hash": "AF6BC0F9BFD3C3DE",
      "target": "No es... \\<suspiro>"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WINDSPATHGARDENSGUARD_000_090",
      "hash": "A87EFE5D90484555",
      "target": "\\<blip> \\<blup> Error. Error. Sistema de verificación... inicializado. Registro de usuario... confirmado."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WINDSPATHGARDENSGUARD_000_091",
      "hash": "46DCBB160F634FA3",
      "target": "¡Saludos y bienvenidos a los Jardines de Sendaviento, el santuario de la exploración y el descubrimiento! ¡Las maravillas del mundo natural les esperan!"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_095",
      "hash": "651F999A9B8845C1",
      "target": "¡Ayudemos a Cahciua a crear unos recuerdos estupendos!"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_100",
      "hash": "AED9BDE825461099",
      "target": "El santuario de la exploración y el descubrimiento... Qué apropiado que los recuerdos de Cahciua estén aquí."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_105",
      "hash": "444AAC6C9E2A60DC",
      "target": "Qué propio de Cahciua perseguir sus sueños hasta el final."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_110",
      "hash": "765D9BD68840B239",
      "target": "..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_120",
      "hash": "916142B3750F0D04",
      "target": "Pues, con vuestro permiso, ¡que empiece nuestra aventura!"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_121",
      "hash": "41B49CA71A655370",
      "target": "Por supuesto, mientras tanto, no dudéis en seguir haciendo amigos entre los Perpetuos. ¡Y no dejéis de empaparos de este paisaje delicioso!"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_WUKLAMAT_000_125",
      "hash": "33A2B70838425794",
      "target": "¡Creía que esas cosas eran una especie de árbol enorme, pero en realidad son esculturas!"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_130",
      "hash": "91ADF59A8D305C74",
      "target": "El paisaje de aquí es sencillamente extraordinario. Y pensar que Sphene ha logrado conservarlo para los Perpetuos..."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_135",
      "hash": "99118298E6DCC696",
      "target": "¡Qué jardín tan precioso!"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_140",
      "hash": "313F31539EB49712",
      "target": "...En cierto modo me lo esperaba."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_150",
      "hash": "8073DBDD677CB08F",
      "target": "Este jardín en concreto se llama Flores del Descubrimiento. Bonito, ¿verdad?"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_GRAHATIA_000_151",
      "hash": "05AA2D690F9E7E96",
      "target": "¡Es absolutamente impresionante! ¿Y son todas plantas de verdad?"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_152",
      "hash": "92498BEFEF4ADCB3",
      "target": "Desde luego que sí. Estos ejemplares se trajeron aquí hace cientos de años para conservarlos, porque la calamidad las había llevado al borde de la extinción."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_KRILE_000_153",
      "hash": "3A57BC77BE75C98D",
      "target": "Así que esta zona es como un gran invernadero de conservación."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_154",
      "hash": "984DF0B1C5DCAB2A",
      "target": "¡Exacto, mi querida Krile! Aquí encontrarás flora y fauna como ya no existe en ninguna otra parte."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_155",
      "hash": "B292C965F546AA0F",
      "target": "¿A que solo de pensarlo se te acelera el corazón?"
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_156",
      "hash": "66223603CBC416FA",
      "target": "Supongo."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_157",
      "hash": "CB70D2358C4B6CAE",
      "target": "Imagino que algunas criaturas que vi fuera de Tural tendrán parientes en este mundo."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_ERENVILLE_000_158",
      "hash": "247959FFF683AE70",
      "target": "Aunque no soy experto en la vida de los reflejos, compararlos daría para un estudio interesante."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_159",
      "hash": "397058AACF610876",
      "target": "¡Eso sí que es una idea! Cómo no se le iba a ocurrir a mi discípulo."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_160",
      "hash": "DAD7AF124B200D50",
      "target": "Aquí tenemos no solo a <if(gnum4,una aventurera,un aventurero)> que recorre mundos y a un espigador veterano, sino además a dos de los mejores eruditos de Sharlayan."
    },
    {
      "gameKey": "quest/049/KinGmf111_04956#TEXT_KINGMF111_04956_CAHCIUA_000_161",
      "hash": "A366B56A5B066AB6",
      "target": "¡Es toda una reunión de curiosos, y me emociona formar parte de ella!"
    }
  ]
}
