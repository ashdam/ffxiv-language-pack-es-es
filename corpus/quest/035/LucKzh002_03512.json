  "conversation": "quest/035/LucKzh002_03512",
  "gameVersion": "2026.09.01.0000.0000",
  "entries": [
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_SEQ_00", "hash": "70D4B0E887789387", "target": "<colortype(508)><edgecolortype(509)> Sincronización de misión<edgecolortype(0)><colortype(0)><br>Hilmar ofrece buen dinero por una tarea en apariencia sencilla." },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_TODO_00", "hash": "AB89153640C9736B", "target": "Llenar las lámparas de minero con aceite de lámpara acre" },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_TODO_01", "hash": "EF7A084E47E61A43", "target": "Informar a Hilmar" },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_HILMAR_000_000", "hash": "0059E4C4297FEA0E", "target": "¿Estás <if(gnum4,ocupada,ocupado)>? Ya me parecía que no." },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_HILMAR_000_001", "hash": "E9BF9E19BB688D15", "target": "Ofrezco monedas a quien esté dispuesto a llenar las lámparas. ¿Te interesa?" },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_HILMAR_000_002", "hash": "F4075D7EABAE8840", "target": "Son cuatro. Aquí tienes el aceite. Ven a verme cuando termines." },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_HILMAR_000_010", "hash": "1EFB14B3C54F5A09", "target": "Me gustaría que se hiciera ya, si no te importa." },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_HILMAR_000_020", "hash": "675E0A9C50F7C2FC", "target": "Por fin has acabado. Los gnomes no te dieron guerra, ¿verdad?" },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_HILMAR_000_021", "hash": "395ADCCD69256F5D", "target": "Últimamente parece que hay cada vez más. Hasta llenar las lámparas se vuelve un fastidio de mil demonios." },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_HILMAR_000_022", "hash": "3BEC3881F47683CB", "target": "Aun así, no podemos dejar que nos impidan trabajar. No es más que otro gaje del oficio." },
    { "gameKey": "quest/035/LucKzh002_03512#TEXT_LUCKZH002_03512_HILMAR_000_023", "hash": "42CC7B7B80DE1E6D", "target": "En fin, aquí tienes tu paga. Buen trabajo, pecador." }
  ]
}
