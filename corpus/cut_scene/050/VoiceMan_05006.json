{
  "conversation": "cut_scene/050/VoiceMan_05006",
  "gameVersion": "2026.08.11.0000.0000",
  "entries": [
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000001_OLDTITANIA", "hash": "C563DA51EB6B0615", "target": "¿Quién anda ahí? ¿Eres tú quien rompió el sello?" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000002_OLDTITANIA", "hash": "6F06D40A3ADCA366", "target": "Ah, cuánto tiempo perdido... Cuántos juegos y festines quedaron sin disfrutar..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000003_OLDTITANIA", "hash": "0A5521D2E22C6AAA", "target": "Hay que recuperarlo, hay que hacerlo... ¡Empezando por jugar <italic(1)>contigo<italic(0)>!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000010_OLDTITANIA", "hash": "F6750105EA33FFB6", "target": "Ya no... podemos jugar... más..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000110_VAUTHRY", "hash": "BD6CF9EB7F3ED4EC", "target": "¿Tan empeñados estáis en morir? Una última oportunidad, bellacos: postraos y reconoced a vuestro rey. ¡A vuestro dios!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000120_VAUTHRY", "hash": "1BB2136161BB98A7", "target": "Pero... si yo soy todopoderoso..." },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000210_EMETSELCH", "hash": "3164D5E59540FB73", "target": "Muéstrame esa fuerza tan «cacareada». ¡Y yo dejaré al descubierto la mentira de tu existencia fragmentada!" },
    { "gameKey": "cut_scene/050/VoiceMan_05006#TEXT_VOICEMAN_05006_000220_EMETSELCH", "hash": "04BF5A9209AB3A78", "target": "¡Tú... tú no tienes ningún poder sobre mí!" }
  ]
}
