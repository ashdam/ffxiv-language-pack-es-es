{
  "conversation": "cut_scene/054/VoiceMan_05401",
  "gameVersion": "2026.08.11.0000.0000",
  "entries": [
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000010_GAIA", "hash": "378E3D05CFEFB796", "target": "Voy a hacer aflorar la Oscuridad. ¡Preparaos!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000020_RYNE", "hash": "4364868516E1DAAD", "target": "¡Ha funcionado, Gaia! ¡Lo hemos conseguido!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000030_RYNE", "hash": "906AFEB60AA631C4", "target": "Así que todo esto ocurrió hace cien años..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000040_RYNE", "hash": "8A66BE3D0ECDCE21", "target": "Pero ¿qué tiene que ver con Gaia?" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000050_RYNE", "hash": "BB2E501B4A50ECBA", "target": "¡Conozco este sitio...! ¡Es la prisión de Eulmore!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000060_RYNE", "hash": "110276C3593B06E0", "target": "Sea lo que sea lo que se interponga en nuestro camino..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000070_RYNE", "hash": "19366ED8C2C40ADC", "target": "...¡nunca perderemos la esperanza!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000080_EDEN3BOSS3", "hash": "C5A6CB59793DA188", "target": "Merece... toda la felicidad... del mundo..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000090_EDEN3BOSS4", "hash": "7534593E01460C5B", "target": "Eden se convertirá en una utopía..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000100_EDEN3BOSS4", "hash": "991BA113F7B501E2", "target": "Una que podamos compartir por toda la eternidad." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000110_RYNE", "hash": "BDF0C57278417B5D", "target": "Sigue ahí dentro, en alguna parte..." },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000120_RYNE", "hash": "DE791688CA0EFF4B", "target": "¡No renunciaré a nuestro futuro, Gaia! ¡Pase lo que pase!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000130_EDEN3BOSS4", "hash": "447FE07482C27677", "target": "¡Nuestra utopía... nuestro sueño!" },
    { "gameKey": "cut_scene/054/VoiceMan_05401#TEXT_VOICEMAN_05401_000140_EDEN3BOSS5", "hash": "77C4DB2BDCFB9420", "target": "Yo... regresaré..." }
  ]
}
