    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_A7", "hash": "A3DBA956D4B9B34A", "target": "Equipo del Diadema de sanación." },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_A8", "hash": "FC31CBABB524BB18", "target": "Cancelar" },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_001", "hash": "AEAF8DD583F464AF", "target": "No me haga usted caso, <if(gnum4,señorita,señor)>. No soy más que un humilde comerciante encargado de comprar el equipo no deseado que los aventureros consiguen en el Diadema." },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_011", "hash": "A76090BFD288D4E6", "target": "Le pido disculpas, <if(gnum4,señorita,señor)>, pero ¿tiene usted por casualidad algún equipo del Diadema? ¿No? Bueno, si llega a hacerse con alguno, sepa que se lo compraré con gusto." },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_021", "hash": "40C9E8808AF486E8", "target": "No tendrá usted encima algún cachivache del Diadema, ¿verdad? Ya me parecía. Si conoce a alguien que tenga, hágale saber que yo compro, ¿de acuerdo?" },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_031", "hash": "442B1A935DEBDBF4", "target": "Me da usted la impresión de ser de espíritu aventurero. Por si sus aventuras le llevan al Diadema, quizá dé con cierta clase de equipo... lo reconocerá en cuanto lo vea, créame. Tráigalo aquí y me encargaré de que se le recompense como es debido." },
    { "gameKey": "custom/003/CmnDefSkyIslandAetherialExchangeShop_00320#TEXT_CMNDEFSKYISLANDAETHERIALEXCHANGESHOP_00320_041", "hash": "CFC204E77A397F5A", "target": "Le saludo, <if(gnum4,buena señora,buen señor)>. Soy coleccionista de equipo raro, en concreto del que se halla en el Diadema. Si me trae tales artículos, le proporcionaré una recompensa adecuada." }
