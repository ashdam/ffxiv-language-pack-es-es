    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_TEST_ENTER_FIXED_Q", "hash": "30D50D511BD07192", "target": "¿Seguro que quieres entrar con un grupo fijo?" },
    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_TEST_ENTER_MATCHING_Q", "hash": "9BE81FDAFFF86489", "target": "¿Seguro que quieres entrar con un grupo emparejado?" },
    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_WOODWAILERCAPTAIN01556_000_050", "hash": "7C772C2E971CDB89", "target": "¿¡Piensas adentrarte a solas en las ruinas!? Con tus fuerzas mermadas por las magias de las ruinas, no tendrás más ayuda que las armas de éter de los Padjal. Puede que ni siquiera basten sin mejoras." },
    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_TEST_ENTER_SOLO", "hash": "1A51FF6350853447", "target": "¿Seguro que quieres entrar a solas?" },
