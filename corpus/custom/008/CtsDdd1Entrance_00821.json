  "entries": [
    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_WOODWAILERCAPTAIN01556_000_000", "hash": "951BAF65DE8465C0", "target": "Una gran amenaza para la paz aquí, en el Bosque del Velo Negro, se ha manifestado, y me han enviado a ayudar a expulsarla. Seas aventurero o no, no toleraré que nadie interfiera en mi labor. Ahora, por favor, sigue tu camino." },
    { "gameKey": "custom/008/CtsDdd1Entrance_00821#TEXT_CTSDDD1ENTRANCE_00821_WOODWAILERCAPTAIN01556_000_020", "hash": "E440444D28FE400F", "target": "Tuvimos suerte de que el custodio de ese maldito lugar fuera lo bastante descuidado como para dejar sus notas donde pudiéramos encontrarlas. Quizá ahora podamos descubrir sus verdaderos motivos." },
