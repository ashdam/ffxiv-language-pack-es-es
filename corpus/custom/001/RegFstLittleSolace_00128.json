{
  "conversation": "custom/001/RegFstLittleSolace_00128",
  "gameVersion": "2026.09.01.0000.0000",
  "entries": [
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_KNOLEXIA_000_000", "hash": "01D9D31657FC4BC5", "target": "Esta saluda al caminante. ¿Necesita el caminante algo de esta?" },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_KNOLEXIA_000_010", "hash": "A85E93B29CD42CFD", "target": "A esta la llaman Knolexia. A esta le encargan tejer para bien de todas estas." },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_KNOLEXIA_000_011", "hash": "2D8169FE6BDDF44A", "target": "Estas son diestras tejiendo. ¡Con aguja e hilo, estas pueden hacer casi cualquier cosa, hasta casas!" },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_KNOLEXIA_000_012", "hash": "635A5C95FF3F71A1", "target": "¿El caminante repara en los bordados de las casas? ¡Motivos encantados para repeler a las cosas oscuras!" },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_KNOLEXIA_000_020", "hash": "0E0827151F09EB6F", "target": "A este lugar lo llaman el Pequeño Solaz, el nuevo hogar de estas." },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_KNOLEXIA_000_021", "hash": "3FF048B353C9808A", "target": "Estas vivían felices en lo profundo del bosque, pero entonces unas traviesas fueron y convocaron a un primigenio." },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_KNOLEXIA_000_022", "hash": "84856D452ADEF9F3", "target": "Por miedo a las traviesas que se volvieron tocadas, estas huyeron de su tierra natal. Gracias a la cornuda Kan<-->E, estas pudieron construir un nuevo hogar aquí." },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_KNOLEXIA_000_023", "hash": "810709A14257F6AE", "target": "Esta no sabe cuándo, pero algún día estas volverán a casa. ¡Esta tiene esperanza!" },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_Q1_000_000", "hash": "666D029F87DD0AB1", "target": "¿Qué vas a preguntar?" },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_A1_000_001", "hash": "D6340ABBFEAB4FFA", "target": "¿A qué te dedicas aquí?" },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_A1_000_002", "hash": "B4050036169B32D5", "target": "¿Qué clase de sitio es este?" },
    { "gameKey": "custom/001/RegFstLittleSolace_00128#TEXT_REGFSTLITTLESOLACE_00128_A1_000_003", "hash": "3D0E7B98329AA3EF", "target": "Nada." }
  ]
}
