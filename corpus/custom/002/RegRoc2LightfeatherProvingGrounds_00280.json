    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_000", "hash": "54BB88541E2F0C87", "target": "¡Oh! Hola. Bienvenido al Campo de Pruebas de Pluma Ligera." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_Q1_000_000", "hash": "B9B21FEEC5AE6990", "target": "¿Qué vas a preguntar?" },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_001", "hash": "E724A2F89110B3CF", "target": "¿A qué te dedicas aquí?" },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_002", "hash": "14C86A15FAEB94C9", "target": "¿Qué clase de sitio es este?" },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_A1_000_003", "hash": "DB23D9F9D1E667EC", "target": "Nada." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_010", "hash": "6505D000C77B4A56", "target": "Oficialmente, se supone que debo enseñar el lugar y responder a las preguntas, pero en la práctica apenas hace falta, porque rara vez vemos caras nuevas por aquí." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_011", "hash": "C1C912FFFAE41AD2", "target": "No es que me importe. Más bien me gusta tener libertad para ver los combates." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_020", "hash": "ADD7DA9D379ABF65", "target": "Como cabe suponer por el nombre, el Campo de Pruebas de Pluma Ligera se creó en un principio para acoger combates de chocobos adiestrados para la batalla." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_021", "hash": "39A14D093F8BB0A0", "target": "Dicho esto, la Casa Dzemael ha permitido desde entonces que el recinto se use en ocasiones para otros fines." },
    { "gameKey": "custom/002/RegRoc2LightfeatherProvingGrounds_00280#TEXT_REGROC2LIGHTFEATHERPROVINGGROUNDS_00280_ALINAURE_000_022", "hash": "7592F5ED27833AD0", "target": "Algunas otras casas han organizado espectáculos, tanto para el disfrute privado como para el público. Los Caballeros del Templo también han celebrado exhibiciones en el pasado... y son siempre un deleite, se lo aseguro." }
