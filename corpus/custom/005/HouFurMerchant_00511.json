    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE1", "hash": "7DD3CEDEA0BA0800", "target": "Ya estoy aquí, mi <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE2", "hash": "5A62FE8EAF415E5D", "target": "No hay nada de que preocuparse." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE3", "hash": "CE00F65C00EBC5BE", "target": "¿Me ha llamado?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE4", "hash": "859B08A2503A5AAE", "target": "¿Sí? \\<suspiro> Espero que esto no lleve mucho..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE5", "hash": "F638B81C23CDA6FF", "target": "¿Quiere ver cómo un maestro maneja un bazar?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_MALE_TYPE6", "hash": "5AE55FA7CC9C0621", "target": "¡Hola, hola! ¿Me ha llamado?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE1", "hash": "F5C949592DDFEC3B", "target": "A su servicio, mi <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE2", "hash": "012F7F46513EB2D9", "target": "¿Qué va a ser esta vez, encanto?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE3", "hash": "7C7B9158EC1A110C", "target": "¿Qué desea pedir?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE4", "hash": "52F62D6DA83D4308", "target": "Siento muchísimo haberle hecho esperar, <if(gnum4,señora,señor)>. Lo siento muchísimo, de verdad." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE5", "hash": "1E8A617D04953C1B", "target": "Rápido, que tengo cosas que hacer." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HYURAN_FEMALE_TYPE6", "hash": "B9571B5551F411DE", "target": "¡Vaya, pero si es mi cliente favorito! ¡Siempre es un placer, <if(gnum4,señora,señor)>!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE1", "hash": "2AB8C1FBE249A401", "target": "¿Sí, <if(gnum4,señora,señor)>? ¿Qué desea ordenar?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE2", "hash": "D58014FF6C45B694", "target": "¿Qué hay en la agenda, jefe? ¿Desplumar a algún primo de su gil bien ganado?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE3", "hash": "82FD2BB233D9BE05", "target": "He venido. Puede proceder." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE4", "hash": "17AB77EC51236518", "target": "Ah, hola. ¿A qué debo el placer?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE5", "hash": "BDF39A6397039511", "target": "He venido a hacer negocios, y solo negocios." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_MALE_TYPE6", "hash": "3C7C0EACC41411D0", "target": "Se le ve rebosante de salud, <if(gnum4,señora,señor)>. ¿En qué puedo ayudarle en <if([gnum11<12],<if([gnum11<4],esta hermosa noche,esta hermosa mañana)>,<if([gnum11<17],este hermoso día,esta hermosa tarde)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE1", "hash": "9E1295E7AC4B9C21", "target": "¿Qué desea que haga, <if(gnum4,mi señora,mi señor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE2", "hash": "7D3FC139E86984E1", "target": "Normalmente soy yo quien llama y los demás quienes esperan." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE3", "hash": "ED24FF5DA930F1A4", "target": "¿Hay algo en lo que pueda ayudarle?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE4", "hash": "902F16D65FE73B8C", "target": "Ay, ¿por qué tiene que llamarme en un momento así...?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE5", "hash": "C06BBA87E06578C8", "target": "Seguro que hay una explicación de lo más razonable para esta llamada." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ELEZEN_FEMALE_TYPE6", "hash": "B1C5B59644878380", "target": "¿Sabe? Me imaginaba que vendría a llamarme. Puede estar tranquilo: estoy lista y deseosa de servir." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE1", "hash": "D1D730C68C6DEC11", "target": "Salve, <if(gnum4,señora,señor)>. Su humilde sirviente ha oído su llamada." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE2", "hash": "F84C47511BA25E9A", "target": "Saludos y parabienes, <if(gnum4,ama,amo)>. Diga sus deseos, y haré todo lo posible por cumplirlos." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE3", "hash": "796B673E9A13C265", "target": "Me preguntaba cuándo se decidiría a llamarme." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE4", "hash": "8CF9411B6556587D", "target": "¿Le importa que seamos breves? Tengo a una preciosidad esperándome." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE5", "hash": "00FF44E6FC84A0C2", "target": "¿Qué?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_MALE_TYPE6", "hash": "4BF98D696634555A", "target": "¡Ya estoy aquí, ya estoy aquí!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE1", "hash": "C274C397AD53CB55", "target": "Aquí estoy, mi <if(gnum4,señora,señor)>, tal como ha pedido." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE2", "hash": "612E4AD32C521C44", "target": "Hola, cielo. ¿Qué hay en la lista?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE3", "hash": "B8B60A6D01456F11", "target": "Nunca dejo pasar la ocasión de llenarme los bolsillos." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE4", "hash": "8D1865E0370A49A5", "target": "¡Vaya, esto sí que no me lo esperaba! ¿Qué va a ser?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE5", "hash": "2F5E335CA2862111", "target": "¿Y ahora qué?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_LALAFELL_FEMALE_TYPE6", "hash": "970A04EB398CB378", "target": "¡Ya estoy aquíííííí!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE1", "hash": "5E1F967DF05D820C", "target": "¿En qué puedo servirle, <if(gnum4,señora,señor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE2", "hash": "B14A234DB7837713", "target": "Es una guerrra ahí fuera, <if(gnum4,señorita,señor)>. No tiene ni idea." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE3", "hash": "5905787E93C032F7", "target": "..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE4", "hash": "3F43AD9F909D6289", "target": "¿Negocios o placer?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE5", "hash": "B3674C9612925B93", "target": "Presumo que no me ha llamado solo por el placer de mi compañía." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_MALE_TYPE6", "hash": "F547E9C270766A63", "target": "¡Justo <if(gnum4,la bella dama,el apuesto caballero)> que esperaba ver! Dígame el deseo de su corazón." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE1", "hash": "CD2FB037367201E6", "target": "Espero que ese silbido no sea de desaprobación." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE2", "hash": "0F20EAB84B905EEE", "target": "¿Ha llamado, <if(gnum4,mi señora,mi señor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE3", "hash": "9BF08255180A7428", "target": "Los oídos de un gato no se pierden gran cosa―y menos aún una llamada." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE4", "hash": "BCFBAF5F1F836346", "target": "La currriosidad mató al gato. ¿Qué tiene hoy para mí?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE5", "hash": "20D400D64318A1E8", "target": "Cuando usted diga." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_MIQOTE_FEMALE_TYPE6", "hash": "AB7245A1A5361A50", "target": "¡Justo estaba pensando en usted!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE1", "hash": "DC7509EFD4EE906B", "target": "¿Qué necesita de mí hoy, <if(gnum4,señora,señor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE2", "hash": "0F74038BDDC1274B", "target": "¡Buajajaja! ¿Tiene trabajo que hacer? Solo tiene que señalarme la maldita dirección correcta." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE3", "hash": "EA201EF608AEFADC", "target": "He venido. ¿Qué ocurre?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE4", "hash": "2CA66C9D8A3A5E8B", "target": "¡Eh, hola─hip─<if(gnum4,señorita,amigo)>! ¿Le apetece tomar una jarra conmigo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE5", "hash": "86D3758D6307C489", "target": "No podía venir más rápido. ¿Dónde está el trabajo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_MALE_TYPE6", "hash": "6B02C3F1AF4A2B25", "target": "¡Vine corriendo en cuanto oí la campanilla! ¿Necesita algo, jefe?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE1", "hash": "4CC428F6640E9C71", "target": "Estoy a su disposición, <if(gnum4,mi señora,mi señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE2", "hash": "3A635206D530D151", "target": "¿Tiene algo para mí, capitán?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE3", "hash": "514CB62E02D15C66", "target": "Adelante, <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE4", "hash": "750F501436084153", "target": "Vamos a hacerlo cortito y al grano, ¿le parece?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE5", "hash": "9EEC19972F7A1AB8", "target": "Nada de esto sería necesario si me confiara sus asuntos financieros." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_ROEGADYN_FEMALE_TYPE6", "hash": "0923F1B49CF66C2E", "target": "Así que─¿vender, comprar, beber, ir de picos pardos? ¿Qué va a ser hoy?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE1", "hash": "69E2C419843E145B", "target": "Saludos, <if(gnum4,señora,señor)>. ¿En qué puedo servirle?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE2", "hash": "AFC46CAC3F1B77CF", "target": "¿Qué va a ser, <if(gnum4,señorita,amigo)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE3", "hash": "BEF93F1846E7D792", "target": "Diga a qué ha venido." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE4", "hash": "6F6244639104247D", "target": "¿Y cómo le encuentra <if([gnum11<12],<if([gnum11<4],esta maravillosa noche,este maravilloso día)>,<if([gnum11<17],este maravilloso día,esta maravillosa noche)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE5", "hash": "CE3347D641BAB9FD", "target": "Bueno... Aquí estoy... mi <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_MALE_TYPE6", "hash": "8BC9D106BD0609B5", "target": "Trabajamos en los puestos del mercado,♪<br>y nuestros uniformes son bonitos;♪<br>somos hombres sobrios y cabales,♪<br>¡y atentos a nuestros deberes!♪" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE1", "hash": "1A4D886EA936445D", "target": "<if(gnum4,Mi señora,Mi señor)>. ¿Qué desea pedirme?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE2", "hash": "415B5CF8E4F87007", "target": "Bueno. ¿Lo hacemos?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE3", "hash": "EC8C44309097A931", "target": "¿Sí?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE4", "hash": "60E22049088269DE", "target": "¡Eh, es... es usted! ¡Hola otra vez!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE5", "hash": "8498C894B22C4603", "target": "N-no es que quiera vender sus objetos ni nada de eso." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_AURA_FEMALE_TYPE6", "hash": "44E20E73EDEB780E", "target": "¿Qué tiene para mí? ¡Vamos, vamos! ¡No sea tímido!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE1", "hash": "8A083E1A6FD76849", "target": "¿Ha llamado, <if(gnum4,mi señora,mi señor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE2", "hash": "2E65686EF7AC1A78", "target": "Confío en que merecerá la pena." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE3", "hash": "59E897BE3EA9B59A", "target": "¿<italic(1)>Qué<italic(0)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE4", "hash": "2487E7ACF5239240", "target": "Lo que necesite, ¡déjelo en mis manos! Tengo mis métodos." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE5", "hash": "938D05EC6A512509", "target": "¡Gahaha! ¡Pero si es mi <if(gnum4,señora,señor)> favorito!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_MALE_TYPE6", "hash": "7C84CB32D00AEABD", "target": "¡Soy yo, su sirviente más leal y capaz!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE1", "hash": "7425F30367D9CFDF", "target": "¿Qué va a ser, encanto?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE2", "hash": "3695A28EF246A58C", "target": "¡Sus órdenes! ¡Deseo oírlas de inmediato!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE3", "hash": "190B34BAEFE15AC7", "target": "Si hay algo que quiera pedirme, pídalo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE4", "hash": "20CC450A51D26342", "target": "¿Sí...? ¿Necesita―\\<bostezo>―algo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE5", "hash": "FA8EE46ECAD554D5", "target": "¿Una tarea para mí? ¡Espero que sea algo divertido!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_FEMALE_TYPE6", "hash": "D4537748FEA28406", "target": "¡Estoy aquí para cumplir todas sus órdenes, <if(gnum4,señora,señor)>! ¡Pídame lo que sea!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE1", "hash": "3B4F2478F64B414D", "target": "He estado esperando su llamada, <if(gnum4,señora,señor)>. ¿Qué desea de mí en <if([gnum11<12],<if([gnum11<4],esta hermosa noche,esta hermosa mañana)>,<if([gnum11<17],este hermoso día,esta hermosa tarde)>)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE2", "hash": "5F56E6E9F8174AE6", "target": "¿Qué puedo hacer por su <if(gnum4,señoría,señoría)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE3", "hash": "AE1FBFC5AE9B7F14", "target": "¿Ha llamado, <if(gnum4,señora,señor)>...?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE4", "hash": "C6300B9819E9144C", "target": "¿Ha―hip―llamado?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE5", "hash": "88BD26F9FFF475AF", "target": "¿Necesita mi ayuda? Pues acabemos rápido." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_VIERA_MALE_TYPE6", "hash": "81A814A7B1D7A52D", "target": "Le escucho, <if(gnum4,mi señora,mi señor)>. ¡Con ambos oídos, de hecho!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE1", "hash": "BEABDBFBE0D456A5", "target": "¿Me ha llamado, <if(gnum4,señora,señor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE2", "hash": "497DF99CF329948B", "target": "¡A su entera disposición!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE3", "hash": "F5AB8C10D40B23CA", "target": "Ha llamado, y he venido." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE4", "hash": "EDAB70F474EDE4DC", "target": "Por fin... Creía que <italic(1)>nunca<italic(0)> me llamaría. ¿Qué necesita de mí <if(gnum4,mi señora,mi señor)>?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE5", "hash": "B8811F3FDA5013F0", "target": "¿Será posible...? ¿<split(<string(gstr1)>, ,1)>, el famoso, me ha llamado a <italic(1)>mí<italic(0)>? \\<risita>" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_ENTER_HROTHGAR_FEMALE_TYPE6", "hash": "0FEF2A4C857E019F", "target": "¡Sí, sí, aquí estoy! ¡Lista en cualquier momento!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE1", "hash": "88D463EC8F658FA7", "target": "Si eso es todo, me retiro ya, mi <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE2", "hash": "849D81FC7DAD90B3", "target": "Cuídese, ¿me oye?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE3", "hash": "E1099B5E7A356733", "target": "Hasta la próxima." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE4", "hash": "3FB6CD3E06EC78BE", "target": "Bueno, ya era hora. Adiós." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE5", "hash": "F24FB14000CF01A7", "target": "Creo que unas gracias serían de recibo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_MALE_TYPE6", "hash": "4A02FE143E4553C2", "target": "¡Me voy, pues!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE1", "hash": "A1D16E93FE280EE5", "target": "Con su permiso, mi <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE2", "hash": "EA2E1ABB7A29A1F0", "target": "No se preocupe por nada. Yo me encargo." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE3", "hash": "893A335E51F1497D", "target": "Adiós, pues." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE4", "hash": "0C503B4EBE46A5BC", "target": "Si no hay nada más, <if(gnum4,señora,señor)>, me marcho ya." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE5", "hash": "0372772E633E82A8", "target": "¿Eso es todo? Muy bien, hasta la próxima." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HYURAN_FEMALE_TYPE6", "hash": "C4E9F6F39D7CAC42", "target": "Ah, ¿eso es todo por hoy? Muy bien, ¡pero prométame que volverá pronto!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE1", "hash": "6ECC28A5A20CFF53", "target": "Como siempre, <if(gnum4,señora,señor)>, ha sido un honor y un privilegio." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE2", "hash": "334707F26ED0F881", "target": "Puede contar conmigo, jefe─sé cómo sacar las cosas adelante." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE3", "hash": "3A5B427C8D71EADF", "target": "No desaparezca." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE4", "hash": "AB2D78180890554D", "target": "Juro que se hará. Tarde o temprano." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE5", "hash": "6E233E5428D80033", "target": "Como desee." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_MALE_TYPE6", "hash": "6FFEB5415F61E4EF", "target": "¡Estupendo! Cumpliré sus órdenes de inmediato." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE1", "hash": "60FFCA2960EDF641", "target": "Aguardo humildemente su próxima llamada, <if(gnum4,mi señora,mi señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE2", "hash": "EE70BF1D65137631", "target": "No me deje sola demasiado tiempo, ¿me oye?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE3", "hash": "AFF49D7A5FFE694F", "target": "Siempre es un placer." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE4", "hash": "E9A09D8DFF23EC4A", "target": "Eso es todo, ¿verdad? Entonces, si me disculpa..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE5", "hash": "F255DE42810E1852", "target": "Creo que con esto concluyen nuestros tratos por ahora." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ELEZEN_FEMALE_TYPE6", "hash": "6D8EE315750B9273", "target": "¿Seguro que no desea nada más? ¿Nada en absoluto? Muy bien, me retiro." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE1", "hash": "01A81DD41FBC9E36", "target": "Cada uno de sus caprichos se cumplirá con presteza y con el debido cuidado y esmero." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE2", "hash": "5BF7B95AC3847613", "target": "No debería llevar más de un momento, <if(gnum4,mi señora,mi señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE3", "hash": "E09DE56E4D72C33C", "target": "Me voy, pues." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE4", "hash": "B208AF9A6ADB7064", "target": "Gracias a los dioses que hemos terminado. Tengo planes de meter las manos en sitios que no he visto nunca... ya me entiende." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE5", "hash": "6A30C711FF4F87AC", "target": "Que le vaya bien." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_MALE_TYPE6", "hash": "0092D04A83F9E6C9", "target": "¡Me voy, me voy!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE1", "hash": "DF69E40794DFE5FF", "target": "¡Hasta que volvamos a vernos!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE2", "hash": "99CFC19E40715296", "target": "Que los Doce le bendigan." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE3", "hash": "9CD78DADB67CBFFF", "target": "¡Que Nald'thal tenga a bien llenarnos los bolsillos!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE4", "hash": "9EAB87FFF6DE0A5C", "target": "¡Muy bien, <if(gnum4,señora,señor)>! Sus deseos son órdenes, y demás." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE5", "hash": "7018FB750ECE9AC9", "target": "Ya sabe cómo localizarme." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_LALAFELL_FEMALE_TYPE6", "hash": "6C57F9571D77D01A", "target": "¿Ya toca despedirse? Le voy a echar de menos..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE1", "hash": "69A1455EE27222E0", "target": "Hágase su voluntad." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE2", "hash": "667F50DAFC05A4DB", "target": "Los mercados serán un maldito campo de batalla, pero yo soy un soldado de tomo y lomo. Puede contar conmigo, <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE3", "hash": "38CCA131983915D1", "target": "..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE4", "hash": "804330C723245237", "target": "¿Por qué tan serrrio? \\<suspiro> Así son las cosas." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE5", "hash": "B59127539CDD2BFD", "target": "No creo que eso justificara mi presencia en persona, pero lo hecho, hecho está." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_MALE_TYPE6", "hash": "D32B63CEF4C6D9BB", "target": "¿Entonces he satisfecho todas sus necesidades? ¡Excelente! Me complace enormemente atender a mis clientes." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE1", "hash": "22414922F1935BF1", "target": "Adiós por ahora, <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE2", "hash": "108B6F2259B60130", "target": "¡Muy bien, pues manos a la obra!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE3", "hash": "52DE8CE9A6D8E20F", "target": "No hay motivo de preocupación." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE4", "hash": "290EF929E78637B8", "target": "Cuando el amo no está, el gato se echa a jugar." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE5", "hash": "FA8C7C6065ED53D2", "target": "Dioses, qué cansancio..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_MIQOTE_FEMALE_TYPE6", "hash": "DE8DA50F9F8D2F27", "target": "¿Ya no quiere estar conmigo? \\<sorbe>" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE1", "hash": "418E2CED424D412C", "target": "Cumpliré sus deseos tal como me ha indicado, <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE2", "hash": "A7F32FBEAEAE1CD7", "target": "¡Buajajaja! ¡Aquí estoy, en su bazar, vendiendo su mercancía!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE3", "hash": "596A086169C8620D", "target": "Me voy ya." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE4", "hash": "1FE03AB6FA4EF373", "target": "Ayyy, maldita sea. Supongo que más vale que me ponga a trabajar..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE5", "hash": "5CA5DCD20541D622", "target": "Yo no me despido." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_MALE_TYPE6", "hash": "18485E817E9798B3", "target": "Váyase a echar una cabezada, jefe. ¡Tiene un aspecto horrible!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE1", "hash": "D50869DEEA72EAFE", "target": "¿Eso es todo por hoy, <if(gnum4,mi señora,mi señor)>? Entendido." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE2", "hash": "2726DC3430FFBA96", "target": "¡A la orden, capitán!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE3", "hash": "6EBDC0D3C0F81F8E", "target": "Tomo nota." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE4", "hash": "54DBADDD740606F3", "target": "No es exactamente como esperaba pasar el día, pero supongo que no hay más remedio." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE5", "hash": "7240C430DA6E781B", "target": "No nos toca preguntar por qué. Solo nos toca obedecer y morir." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_ROEGADYN_FEMALE_TYPE6", "hash": "6684A74D00421F25", "target": "Siempre la profesional consumada, ya veo. Hasta otra, pues." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE1", "hash": "C90E7BD661A1A30E", "target": "Si no hay nada más, me retiro." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE2", "hash": "4339ABC23A6F44A2", "target": "¿Eso es todo? Pues me pondré en camino." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE3", "hash": "1D1B916C6F3A51FB", "target": "¿Alguna última petición? Muy bien. Je, je, je... Ejem." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE4", "hash": "743EEE2C92662B7E", "target": "Ah, sí, claro. ¡El deber llama!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE5", "hash": "BBAE10CEC574F875", "target": "¿Entonces ha terminado conmigo?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_MALE_TYPE6", "hash": "8D85563251905149", "target": "Hoy aquí y mañana en otra parte;♪<br>sí, lo sé─♪<br>¡así es!♪" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE1", "hash": "242AEA23EBED69FE", "target": "Si alguna vez me necesita, no tiene más que tocar la campanilla." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE2", "hash": "B561EBF9455B518A", "target": "Siempre es un placer, mi <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE3", "hash": "20204685B662AD42", "target": "Muy bien, pues." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE4", "hash": "74CDBCCD81DB5BCD", "target": "¿Ya está? Pues aquí lo dejamos." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE5", "hash": "B2F10572DA703959", "target": "¿Ya se va? ¡Muy bien, pues! N-no es que quisiera que se quedara ni nada de eso." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_AURA_FEMALE_TYPE6", "hash": "190A5792CC613B94", "target": "¡Muy bien, <if(gnum4,señora,señor)>! ¡Estupendo de verdad!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE1", "hash": "0CDF98D15F0140D2", "target": "Siempre es un placer servirle, <if(gnum4,mi señora,mi señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE2", "hash": "6CF858424E547F48", "target": "Mmpf. Espero que la próxima vez tenga para mí una tarea de más enjundia." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE3", "hash": "1B098026D0C1AF7C", "target": "<italic(1)>Adiós<italic(0)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE4", "hash": "8CA330509327D281", "target": "Y dicho esto, me marcho. Sitios que visitar, gente que ver." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE5", "hash": "BFA406B47E85CE14", "target": "¡Bahahaha! ¡Hasta la próxima, amigo!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_MALE_TYPE6", "hash": "7CFECEDB1D62B750", "target": "¡Llámeme cuando le plazca! ¡Sabe que jamás le fallaré!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE1", "hash": "AEEE2C0A3BEA4681", "target": "¿Tenemos que separarnos tan pronto?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE2", "hash": "7D84B777BCB5A896", "target": "¡Y me voy!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE3", "hash": "4580EE2773C12030", "target": "Llámeme cuando quiera. Si me apetece, responderé." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE4", "hash": "52EC9A9CA2925BA2", "target": "¿Eso es todo, supongo...? \\<bostezo> Muy bien..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE5", "hash": "CF979F188FA5FD94", "target": "¿Eso es todo? Ay, esperaba que hubiera más..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_FEMALE_TYPE6", "hash": "9DFB282B9E8A396B", "target": "¿Es todo lo que necesita de mí? ¡Pero si aún podría servirle de tantas maneras!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE1", "hash": "8D41CD2616D593CA", "target": "No dude en volver a llamarme. Que le vaya bien en sus empresas, <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE2", "hash": "8EE855ACB28966EB", "target": "No tiene más que decirlo, su <if(gnum4,señoría,señoría)>, y aquí estaré de mil amores." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE3", "hash": "323C3622A19961A8", "target": "Si no necesita más mis servicios..." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE4", "hash": "4296B8FB1223B597", "target": "Me voy a por otra copa, pues. ¡Ya sabe dónde encontrarme!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE5", "hash": "59D5A545495AEFA2", "target": "¿Qué? ¿Eso es todo? ¿<italic(1)>Seguro<italic(0)> que necesita un sirviente?" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_VIERA_MALE_TYPE6", "hash": "E2EC97966E1A318B", "target": "¿Nada más? Pues me marcho dando saltitos." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE1", "hash": "F8740AD6E1165066", "target": "Me alegra haber sido de ayuda. No se exceda, <if(gnum4,señora,señor)>." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE2", "hash": "421BFCBABFED884B", "target": "¿Ya se ha cansado de mí, eh? ¡Me parece justo! ¡Avíseme si necesita algo más!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE3", "hash": "39312F369BCC7E1C", "target": "¿Hemos terminado? Pues me retiro." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE4", "hash": "1089923CA3E0BAAA", "target": "¿No necesita nada más <if(gnum4,mi señora,mi señor)>? Pues estaré afilándome las garras, esperando su próxima llamada." },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE5", "hash": "DE833458A602DCB5", "target": "¿Nada más? Bien... ¡Me marcho!" },
    { "gameKey": "custom/005/HouFurMerchant_00511#TEXT_HOUFURMERCHANT_00511_LEAVE_HROTHGAR_FEMALE_TYPE6", "hash": "2A697BAEF75219E1", "target": "¿Tiene todo lo que necesita? Pues me echaré una siestecita." }
  ]
}
