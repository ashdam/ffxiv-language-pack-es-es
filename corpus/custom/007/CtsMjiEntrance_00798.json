{
  "conversation": "custom/007/CtsMjiEntrance_00798",
  "gameVersion": "2026.09.01.0000.0000",
  "entries": [
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_000_000", "hash": "3D06F797198F019B", "target": "¡Ah del barco, <if(gnum4,muchacha,muchacho)>! ¿Adónde te llevo?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_020", "hash": "993BE6DCD5FF5AC7", "target": "Debes regresar a tu Mundo de origen para viajar a tu propia isla." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_000", "hash": "9001FF9D67685FF6", "target": "¿Qué vas a hacer?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_005", "hash": "BCDE85DBB5B07F5E", "target": "¿Viajar a tu isla?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_010", "hash": "85A5EA89029892CB", "target": "¿Qué tipo de conocido?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_000_015", "hash": "499D436C2379EF57", "target": "¿Qué vas a preguntar?" },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_000", "hash": "264B296B9D81AFC4", "target": "Viajar a mi isla." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_005", "hash": "03B7445ABEB84BE3", "target": "Viajar a la isla de un conocido." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_010", "hash": "D812E7AFD733BF96", "target": "Saber más." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q1_000_015", "hash": "E05B8B330D14F7AA", "target": "Nada." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_000", "hash": "3631EBAB3EE585C8", "target": "Preguntar por tu isla." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_005", "hash": "458B074F50629AB0", "target": "Preguntar por tu isla." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_010", "hash": "7013CBAFF4D69EFD", "target": "Preguntar por las islas de los conocidos." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q2_000_015", "hash": "E1856FA1DA727551", "target": "Nada." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_000", "hash": "EFFCAEB962945FEB", "target": "Un amigo." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_005", "hash": "403BA90E3B6BD1AC", "target": "Un miembro de mi Free Company." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_010", "hash": "BFD1F1A1562EE085", "target": "Un miembro de mi grupo." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_Q3_000_015", "hash": "A9F582348D6A6FFB", "target": "Nada." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_100_000", "hash": "5371ABFE572E31EC", "target": "¿Me preguntas por tu propia maldita isla? Debes de estar de broma. \\<suspiro> Espero que ese planecillo de Tataru te esté saliendo bien." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_200_000", "hash": "6FAEE783162A48EE", "target": "¿Con ganas de saber qué puedes hacer con tu propia isla, eh? Bueno, puedes hacer lo que quieras con ella, de eso se trata. Constrúyete un pastito para criar animales, cultiva algo o simplemente explora. Tú decides. Si quieres una para ti, te harán falta contactos." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_200_000", "hash": "78E2150E3EB2957F", "target": "Para desbloquear tu propia isla, primero debes completar la misión de la trama principal «El caminante del fin» y avanzar en la misión «En busca de un refugio»." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_200_005", "hash": "54A230D1B548CDB7", "target": "Para desbloquear tu propia isla, primero debes avanzar hasta cierto punto de la misión «En busca de un refugio», que puedes emprender hablando con el pregonero despistado de la Vieja Sharlayan." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_BARDIN_300_000", "hash": "DFAB85234679858A", "target": "La Almirante ha dado permiso a unos cuantos aventureros para cultivar las Cieldalaes, un vasto archipiélago de islas deshabitadas en el mar de Rhotano, por si no lo sabías. Conozco estas aguas como la palma de mi mano, así que tú da la orden y zarpamos." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_300_000", "hash": "A70E44F008B23EAB", "target": "Puedes visitar la isla de un miembro de tu grupo, de tu Free Company o de un amigo que haya desbloqueado esta función." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_300_005", "hash": "E19AA19B08B9DF4F", "target": "No podrás visitar una isla si su propietario ha prohibido el acceso, si no hay nadie en ella o si ya ha alcanzado su capacidad máxima." },
    { "gameKey": "custom/007/CtsMjiEntrance_00798#TEXT_CTSMJIENTRANCE_00798_SYSTEM_300_010", "hash": "4DB795307AA2B389", "target": "Además, debes estar en el Mundo de origen del conocido si deseas visitar su isla." }
  ]
}
