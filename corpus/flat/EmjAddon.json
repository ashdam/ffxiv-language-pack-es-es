    { "gameKey": "EmjAddon#71", "hash": "CEA481617CD8D4CC", "target": "●Un alborotador que forma kan sin preocuparse por nadie y pone la mesa patas arriba." },
    { "gameKey": "EmjAddon#72", "hash": "6387BDEE6EC4A3A0", "target": "●Canta pon sin parar para intentar formar un toitoi." },
    { "gameKey": "EmjAddon#73", "hash": "11DD21E976543055", "target": "●Especialista en mentanpin sanshoku de estilo clásico. A veces se retira por miedo al riichi de otro jugador." },
    { "gameKey": "EmjAddon#74", "hash": "8E4E12F0EDD478C2", "target": "●Le gusta el honitsu. Forma kan para aumentar las dora y lograr puntuaciones altas. También usa damaten, así que no hay que bajar la guardia." },
    { "gameKey": "EmjAddon#75", "hash": "CBBC1AA3F00CE55F", "target": "●Desata su especialidad, el suuankou." },
    { "gameKey": "EmjAddon#76", "hash": "38A5F6A3F47D1120", "target": "●Forma manos con rapidez. Cuidado con sus remontadas repentinas cuando es la banca." },
    { "gameKey": "EmjAddon#77", "hash": "1999CB41D8F28E63", "target": "●Según la leyenda, es un anciano sabio que posee conocimientos ancestrales. Su estilo natural no se opone al flujo de las fichas." },
    { "gameKey": "EmjAddon#78", "hash": "E1AEE5CB92A1DCFB", "target": "●Nadie sabe quién lo invocó en este salón de mahjong ni cuándo." },
