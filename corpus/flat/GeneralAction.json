    { "gameKey": "GeneralAction#13.0", "hash": "329706B15423F553", "target": "Engarce avanzado de materia" },
    { "gameKey": "GeneralAction#13.1", "hash": "0AC4395138BEE39A", "target": "Engarza materia en armas y armaduras. También permite engarzar materia en objetos sin ranuras libres, aunque el éxito no está garantizado." },
