  "entries": [
    { "gameKey": "GeneralAction#1.0", "hash": "F172C0074052DC60", "target": "Ataque automático" },
    { "gameKey": "GeneralAction#1.1", "hash": "491F40B1F8E4ED43", "target": "Ataca automáticamente al objetivo actual a intervalos determinados por tu arma." },
    { "gameKey": "GeneralAction#2.0", "hash": "33A46B5B60E9E964", "target": "Saltar" },
    { "gameKey": "GeneralAction#2.1", "hash": "F20F103FE205C548", "target": "Elevarse del suelo o de otra superficie al flexionar las piernas y extenderlas de golpe." },
    { "gameKey": "GeneralAction#3.0", "hash": "0453C0983E4338A9", "target": "Límite" },
    { "gameKey": "GeneralAction#3.1", "hash": "615074376A682417", "target": "Consume la energía almacenada en el medidor de límite del grupo para ejecutar una poderosa técnica de combate. La técnica depende del <colortype(500)><edgecolortype(501)>rol<edgecolortype(0)><colortype(0)> de quien la inicia.<br>Tanque: Aumenta la defensa del grupo (área de efecto: 50 yalms).<br>Cuerpo a cuerpo: Ataque a un solo objetivo.<br>A distancia: Ataque a todos los objetivos en línea recta (alcance: 30 yalms).<br>Lanzador: Ataque de área (8 yalms/10 yalms/15 yalms).<br>Sanador: Recuperación de PV. Resucita en el nivel 3 (área de efecto: 50 yalms).<br>※Si el objetivo no está debilitado al resucitar, volverá sin debilitamiento. Si está debilitado al resucitar, el contador de debilitamiento se reiniciará." },
    { "gameKey": "GeneralAction#4.0", "hash": "756A7B05B883A50C", "target": "Esprintar" },
    { "gameKey": "GeneralAction#4.1", "hash": "44383BF4902D4A34", "target": "Aumenta la velocidad de movimiento.<br><colortype(504)><edgecolortype(505)>Duración: <edgecolortype(0)><colortype(0)>10 s (20 s fuera de combate)<br>※No disponible en JcJ." },
    { "gameKey": "GeneralAction#5.0", "hash": "4DA935E90959B1A1", "target": "Desíntesis" },
    { "gameKey": "GeneralAction#5.1", "hash": "65027456863EA414", "target": "Desintetiza un objeto para recuperar uno o varios de sus materiales originales." },
    { "gameKey": "GeneralAction#6.0", "hash": "4E8E82F33E3E09FC", "target": "Reparar" },
    { "gameKey": "GeneralAction#6.1", "hash": "1F8B0531582F13E3", "target": "Usa materia oscura para reparar el equipo dañado." },
    { "gameKey": "GeneralAction#7.0", "hash": "D1226DC8E16704ED", "target": "Teletransporte" },
    { "gameKey": "GeneralAction#7.1", "hash": "FE8D5981F73409D9", "target": "Transforma tu cuerpo en éter y teletranspórtate al instante a cualquier eterita con la que te hayas sintonizado. Debes pagar una tarifa en giles al llegar a tu destino." },
    { "gameKey": "GeneralAction#8.0", "hash": "E1E9FF3ECC441519", "target": "Retorno" },
    { "gameKey": "GeneralAction#8.1", "hash": "B99238801D80D91A", "target": "Vuelve al instante a tu punto de retorno actual." },
