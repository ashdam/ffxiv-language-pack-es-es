    { "gameKey": "MJIText#64", "hash": "11DA545A1628A617", "target": "Bancales de tierra fértil y labrada, perfectos para cultivar." },
    { "gameKey": "MJIText#65", "hash": "3D940F0B79DFE3F9", "target": "Un campo verde y exuberante que acoge animales insulares de todas las formas y tamaños." },
    { "gameKey": "MJIText#66", "hash": "6ABB3F169506C94A", "target": "Índice insular" },
