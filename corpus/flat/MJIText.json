    { "gameKey": "MJIText#47", "hash": "57BCF7DA36FF35AF", "target": "Tu punto de partida en estas tierras indómitas, construido a toda prisa con materiales recogidos en la naturaleza." },
    { "gameKey": "MJIText#48", "hash": "B1C0E2B1B3F85B45", "target": "El centro de tus operaciones insulares, un acogedor paso más allá de lo imprescindible." },
    { "gameKey": "MJIText#49", "hash": "5423FBD015B63289", "target": "La piedra angular de tu próspero negocio insular, totalmente renovada por mammets expertos en carpintería." },
    { "gameKey": "MJIText#50", "hash": "BA22E7D21BB11B67", "target": "Cuatro paredes y un tejado bajo el que tus animados mamets elaboran artesanías con entusiasmo." },
    { "gameKey": "MJIText#51", "hash": "7A9448F6945BC14F", "target": "Una instalación modesta y práctica donde tus fiables mammets elaboran productos artesanales." },
    { "gameKey": "MJIText#52", "hash": "80A1EA805EDCAAEF", "target": "Un majestuoso lugar de trabajo concebido para los mammets artesanos profesionales." },
    { "gameKey": "MJIText#53", "hash": "77E28AB2D227CF9B", "target": "Un almacén básico para materiales insulares y punto de reunión de los mammets exploradores." },
    { "gameKey": "MJIText#54", "hash": "D8E980370B3409C7", "target": "Una instalación con espacio de almacenamiento y recursos suficientes para mantener a un equipo fiable de mammets recolectores." },
    { "gameKey": "MJIText#55", "hash": "BE5204087E12FC77", "target": "Un amplio almacén insular de categoría profesional, atendido por mammets espigadores de élite. " },
    { "gameKey": "MJIText#56", "hash": "C42037F5AE413FF9", "target": "Un solar vacío repleto de posibilidades arquitectónicas." },
    { "gameKey": "MJIText#57", "hash": "C9682342FB85033E", "target": "Aspas gigantes que giran, más para mover el molino que muele tu grano que para satisfacer tus gloriosas aspiraciones. Los mammets de la isla las adoran." },
    { "gameKey": "MJIText#58", "hash": "0F5C82B39126B04E", "target": "Un refugio apartado entre ramas altas y frondosas. A los mammets de la isla les encanta." },
    { "gameKey": "MJIText#59", "hash": "1ACC370C77083739", "target": "Los bienintencionados autómatas que regulan su temperatura presumen de que este precioso baño al aire libre te abrasará las impurezas de la piel y te dejará impecable... si sobrevives. Les encanta a los mammets de la isla." },
    { "gameKey": "MJIText#60", "hash": "4DD06BE263B87A25", "target": "Se han dedicado grandes esfuerzos a construir este faro al estilo lominsano, pese a la escasez de materiales y a las acaloradas diferencias creativas entre sus arquitectos mammets. Los mammets de la isla lo adoran." },
    { "gameKey": "MJIText#61", "hash": "F23D90896867CBEF", "target": "Resuelve una duda ancestral: una nutria que <italic(1)>expulsa<italic(0)> agua quizá sea aún más extraña que una nutria fuera del agua. A los mammets de la isla les encanta." },
    { "gameKey": "MJIText#62", "hash": "FC1D8A18ECEA6DDC", "target": "Tierras de cultivo" },
