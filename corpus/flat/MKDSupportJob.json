  "entries": [
    { "gameKey": "MKDSupportJob#0.0", "hash": "4BBA88EAFD0DFFBE", "target": "Phantom Freelancer" },
    { "gameKey": "MKDSupportJob#0.1", "hash": "76F611C565F60298", "target": "Ph. Freelancer" },
    { "gameKey": "MKDSupportJob#0.3", "hash": "3953277178CB9660", "target": "Los recuerdos de viajes recién emprendidos y de otros concluidos hace tiempo encarnan las múltiples técnicas de apoyo de este aventurero libre." },
    { "gameKey": "MKDSupportJob#0.4", "hash": "412B1D804A96C865", "target": "Phantom Freelancer" },
    { "gameKey": "MKDSupportJob#1.0", "hash": "C30351012BBD5294", "target": "Phantom Knight" },
    { "gameKey": "MKDSupportJob#1.1", "hash": "B7742C3F6F6062BA", "target": "Ph. Knight" },
    { "gameKey": "MKDSupportJob#1.3", "hash": "CB4EAD52D55681A1", "target": "Emula estos antiguos recuerdos de un caballero leal y honorable para proteger a tus compañeros del peligro." },
    { "gameKey": "MKDSupportJob#1.4", "hash": "17736741DE595AC3", "target": "Phantom Knight" },
    { "gameKey": "MKDSupportJob#2.0", "hash": "8A42DD63A3ACF012", "target": "Phantom Berserker" },
    { "gameKey": "MKDSupportJob#2.1", "hash": "01CD0B177F6F1679", "target": "Ph. Berserker" },
    { "gameKey": "MKDSupportJob#2.3", "hash": "E669094F2B1A4CD3", "target": "El salvajismo y un valor inquebrantable caracterizan los recuerdos de este antiguo berserker. Sus técnicas conllevan un gran riesgo y una recompensa aún mayor." },
    { "gameKey": "MKDSupportJob#2.4", "hash": "6ECCC42B7579E461", "target": "Phantom Berserker" },
    { "gameKey": "MKDSupportJob#3.0", "hash": "C2D12FB2C9B6A31B", "target": "Phantom Monk" },
    { "gameKey": "MKDSupportJob#3.1", "hash": "C21E1151B4A1B77E", "target": "Ph. Monk" },
    { "gameKey": "MKDSupportJob#3.3", "hash": "E417CA80B42BF051", "target": "Estos recuerdos de la férrea disciplina y la serena meditación de un monje ofrecen una senda hacia un dominio del combate sin igual." },
    { "gameKey": "MKDSupportJob#3.4", "hash": "6051667EAF00102B", "target": "Phantom Monk" },
    { "gameKey": "MKDSupportJob#4.0", "hash": "065E7EE7FD1AA355", "target": "Phantom Ranger" },
    { "gameKey": "MKDSupportJob#4.1", "hash": "DA40B205203EED50", "target": "Ph. Ranger" },
    { "gameKey": "MKDSupportJob#4.3", "hash": "A8D4B3F06ADAF857", "target": "Canaliza estos recuerdos de un montaraz orgulloso y apasionado y aprende a invocar las fuerzas de la naturaleza en la batalla." },
    { "gameKey": "MKDSupportJob#4.4", "hash": "83A1E8B0063A048F", "target": "Phantom Ranger" },
    { "gameKey": "MKDSupportJob#5.0", "hash": "C1202425AB9661AB", "target": "Phantom Samurai" },
    { "gameKey": "MKDSupportJob#5.1", "hash": "0CB15F0D72E73D90", "target": "Ph. Samurai" },
    { "gameKey": "MKDSupportJob#5.3", "hash": "AAEC0E4F6CD5B280", "target": "Un entrenamiento riguroso y un estricto código de honor personifican estos recuerdos de un antiguo samurái. Accede a ellos para abatir a tus enemigos de un único golpe mortal." },
    { "gameKey": "MKDSupportJob#5.4", "hash": "FE05F616139A5E46", "target": "Phantom Samurai" },
    { "gameKey": "MKDSupportJob#6.0", "hash": "589CD9793E04FCCF", "target": "Phantom Bard" },
    { "gameKey": "MKDSupportJob#6.1", "hash": "84B332711BFCCE26", "target": "Ph. Bard" },
    { "gameKey": "MKDSupportJob#6.3", "hash": "4AEE4A89EAF12ED2", "target": "Estos recuerdos resuenan con las vívidas imágenes de la melodiosa canción de un bardo. Aprovéchalos para entonar esas mismas baladas en plena batalla." },
    { "gameKey": "MKDSupportJob#6.4", "hash": "678FD76402DFA2FD", "target": "Phantom Bard" },
    { "gameKey": "MKDSupportJob#7.0", "hash": "59D75D44C52FCB24", "target": "Phantom Geomancer" },
    { "gameKey": "MKDSupportJob#7.1", "hash": "B74B3ED77A609765", "target": "Ph. Geomancer" },
    { "gameKey": "MKDSupportJob#7.3", "hash": "9CA0BD2D2881BBBC", "target": "Los recuerdos de este geomante rebosan de una comprensión ilimitada de las leyes de la naturaleza. Accede a ellos para emplear técnicas que varían según el clima." },
    { "gameKey": "MKDSupportJob#7.4", "hash": "B35CECE4CF63F8D8", "target": "Phantom Geomancer" },
    { "gameKey": "MKDSupportJob#8.0", "hash": "831F8E32CA8D8E00", "target": "Phantom Time Mage" },
    { "gameKey": "MKDSupportJob#8.1", "hash": "0EFB1F2F9815D989", "target": "Ph. Time Mage" },
    { "gameKey": "MKDSupportJob#8.3", "hash": "EC6B14041C7FED64", "target": "Los recuerdos de este antiguo mago del tiempo revelan mucho sobre las leyes del tiempo y sobre cómo manipularlas en tu favor." },
    { "gameKey": "MKDSupportJob#8.4", "hash": "67933EE6C17A84FF", "target": "Phantom Time Mage" },
    { "gameKey": "MKDSupportJob#9.0", "hash": "CEC9A57C7236801F", "target": "Phantom Cannoneer" },
    { "gameKey": "MKDSupportJob#9.1", "hash": "50DCC7A7B0DB6A78", "target": "Ph. Cannoneer" },
    { "gameKey": "MKDSupportJob#9.3", "hash": "50996DEA327C7143", "target": "Un dominio de la balística, tanto teórico como práctico, impregna los recuerdos de este artillero. Emúlalos para bombardear a tus enemigos con potentes proyectiles." },
    { "gameKey": "MKDSupportJob#9.4", "hash": "7B88AE375932635D", "target": "Phantom Cannoneer" },
    { "gameKey": "MKDSupportJob#10.0", "hash": "EB96F82B0BEA7553", "target": "Phantom Chemist" },
    { "gameKey": "MKDSupportJob#10.1", "hash": "8A4AFCEF656A7A43", "target": "Ph. Chemist" },
    { "gameKey": "MKDSupportJob#10.3", "hash": "AEC479FDD0A03016", "target": "Los recuerdos de este boticario ofrecen conocimientos de la antigua teoría medicinal, incluidas técnicas de curación capaces de inclinar la balanza de la batalla a tu favor." },
    { "gameKey": "MKDSupportJob#10.4", "hash": "D3FC862A930971C4", "target": "Phantom Chemist" },
    { "gameKey": "MKDSupportJob#11.0", "hash": "87E4C2A262E3EA1C", "target": "Phantom Oracle" },
    { "gameKey": "MKDSupportJob#11.1", "hash": "C150467564E3CA95", "target": "Ph. Oracle" },
    { "gameKey": "MKDSupportJob#11.3", "hash": "E643C03BA734F9E9", "target": "Dotados de los sentidos sobrenaturales y la clarividencia profética de un oráculo, estos recuerdos prometen el dominio de un sinfín de habilidades de apoyo." },
    { "gameKey": "MKDSupportJob#11.4", "hash": "82DE7552F738268E", "target": "Phantom Oracle" },
    { "gameKey": "MKDSupportJob#12.0", "hash": "0E505003A09E9C8C", "target": "Phantom Thief" },
    { "gameKey": "MKDSupportJob#12.1", "hash": "7062667C38345050", "target": "Ph. Thief" },
    { "gameKey": "MKDSupportJob#12.3", "hash": "82D4D91A9FF89098", "target": "Estos recuerdos de un ladrón diestro y de firmes principios dan acceso a técnicas de supervivencia que sin duda resultarán útiles en la isla." },
    { "gameKey": "MKDSupportJob#12.4", "hash": "D98643AC83B63A4B", "target": "Phantom Thief" },
    { "gameKey": "MKDSupportJob#13.0", "hash": "580BE9E28DEDF63F", "target": "Phantom Mystic Knight" },
    { "gameKey": "MKDSupportJob#13.1", "hash": "C96DC7260A5B8906", "target": "Ph. Mystic Knight" },
    { "gameKey": "MKDSupportJob#13.3", "hash": "F574493F67998A4E", "target": "Impregnados de la diligencia y la destreza arcana de un caballero místico, estos recuerdos son la clave para imbuir tus armas de poderosas magias." },
    { "gameKey": "MKDSupportJob#13.4", "hash": "DFE8A9B1362DC23C", "target": "Phantom Mystic Knight" },
    { "gameKey": "MKDSupportJob#14.0", "hash": "C02E96D721E11BF4", "target": "Phantom Gladiator" },
    { "gameKey": "MKDSupportJob#14.1", "hash": "6F1EEEE07DB9D981", "target": "Ph. Gladiator" },
    { "gameKey": "MKDSupportJob#14.3", "hash": "683446439DBC4214", "target": "Los recuerdos de este gladiador feroz e indómito prometen el dominio de un sinfín de habilidades ofensivas y defensivas." },
    { "gameKey": "MKDSupportJob#14.4", "hash": "BC54C9F41DB74D02", "target": "Phantom Gladiator" },
    { "gameKey": "MKDSupportJob#15.0", "hash": "B09D27343AEBC7E1", "target": "Phantom Dancer" },
    { "gameKey": "MKDSupportJob#15.1", "hash": "1582410AA34A561E", "target": "Ph. Dancer" },
    { "gameKey": "MKDSupportJob#15.3", "hash": "D69F7B825DC00C36", "target": "Absorbe los recuerdos de un bailarín sublime y expresivo para reproducir su hábil juego de pies y otorgarte toda clase de bendiciones." },
    { "gameKey": "MKDSupportJob#15.4", "hash": "D20C5321D6BD6B1A", "target": "Phantom Dancer" },
    { "gameKey": "MKDSupportJob#16.0", "hash": "06B2B0A5C99F2DBD", "target": "Phantom Ninja" },
    { "gameKey": "MKDSupportJob#16.1", "hash": "8F56E876FC401C4F", "target": "Ph. Ninja" },
    { "gameKey": "MKDSupportJob#16.3", "hash": "9B8B077ECB331126", "target": "Estos recuerdos del sigilo y la quietud de un ninja resultarán útiles en un sinfín de situaciones precarias." },
    { "gameKey": "MKDSupportJob#16.4", "hash": "E919C3298694CC35", "target": "Phantom Ninja" },
    { "gameKey": "MKDSupportJob#17.0", "hash": "5BC2270F54F27FFF", "target": "Phantom White Mage" },
    { "gameKey": "MKDSupportJob#17.1", "hash": "4D9EC77ECD475A41", "target": "Ph. White Mage" },
    { "gameKey": "MKDSupportJob#17.3", "hash": "EE540B6859FF054A", "target": "Alcanza el dominio de las técnicas de curación con los reconfortantes recuerdos de un devoto mago blanco." },
    { "gameKey": "MKDSupportJob#17.4", "hash": "117C41EC028D1088", "target": "Phantom White Mage" },
    { "gameKey": "MKDSupportJob#18.0", "hash": "B55880FFAF6CDBB3", "target": "Phantom Black Mage" },
    { "gameKey": "MKDSupportJob#18.1", "hash": "060A666F2F67EF1B", "target": "Ph. Black Mage" },
    { "gameKey": "MKDSupportJob#18.3", "hash": "C86FDA97E5196C90", "target": "Imbuidos de la dedicada investigación y experimentación de un mago negro, estos recuerdos te concederán el arte arcano de la destrucción." },
