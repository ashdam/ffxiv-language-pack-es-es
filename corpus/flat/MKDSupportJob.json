    { "gameKey": "MKDSupportJob#19.0", "hash": "E12C161BABF06A4B", "target": "Phantom Dragoon" },
    { "gameKey": "MKDSupportJob#19.1", "hash": "44CEDF3B21385198", "target": "Ph. Dragoon" },
    { "gameKey": "MKDSupportJob#19.3", "hash": "EF9EFF2C6C3E6508", "target": "Los recuerdos de los viajes de un caballero dragón adiestrado te enseñarán a saltar y ensartar con total impunidad." },
    { "gameKey": "MKDSupportJob#19.4", "hash": "29A845E91EC643D0", "target": "Phantom Dragoon" },
    { "gameKey": "MKDSupportJob#20.0", "hash": "CAA854A5D2DDF058", "target": "Phantom Summoner" },
    { "gameKey": "MKDSupportJob#20.1", "hash": "5634B4CB24388E2F", "target": "Ph. Summoner" },
    { "gameKey": "MKDSupportJob#20.3", "hash": "3385F14B21EA5D19", "target": "Canaliza los recuerdos de un invocador culto y experimentado y aprende a convocar poderosas criaturas diestras tanto en el ataque como en la defensa." },
    { "gameKey": "MKDSupportJob#20.4", "hash": "73CE0E0896122F2C", "target": "Phantom Summoner" },
    { "gameKey": "MKDSupportJob#21.0", "hash": "5CCD5CC7B3E6F47A", "target": "Phantom Mago Azul" },
    { "gameKey": "MKDSupportJob#21.1", "hash": "30F3F4C56BC1AB83", "target": "Ph. Mago Azul" },
    { "gameKey": "MKDSupportJob#21.3", "hash": "9620855D71CD7A69", "target": "Los recuerdos de este hechicero hastiado del mundo están teñidos de una profunda paranoia. Accede a ellos para obtener un poder monstruoso en forma arcana." },
    { "gameKey": "MKDSupportJob#21.4", "hash": "B9F232A4A3E2C154", "target": "Phantom Mago Azul" },
    { "gameKey": "MKDSupportJob#22.0", "hash": "CF9AC10BF9144C53", "target": "Phantom Red Mage" },
    { "gameKey": "MKDSupportJob#22.1", "hash": "D635707728341CB4", "target": "Ph. Red Mage" },
    { "gameKey": "MKDSupportJob#22.3", "hash": "18FA63CFE418CB82", "target": "Estos recuerdos de un mago rojo ingenioso y errante te permitirán manejar las magias blanca y negra en perfecto equilibrio." },
    { "gameKey": "MKDSupportJob#22.4", "hash": "6A0D9809BA858A47", "target": "Phantom Red Mage" },
    { "gameKey": "MKDSupportJob#23.0", "hash": "1E9E4CD0C908D103", "target": "Phantom Necromancer" },
    { "gameKey": "MKDSupportJob#23.1", "hash": "82C92D9A2376B333", "target": "Ph. Necromancer" },
    { "gameKey": "MKDSupportJob#23.3", "hash": "01DC065F9E320F23", "target": "Contaminados por la tenacidad de un nigromante profanado, estos recuerdos prometen el poder de combatir más allá de la muerte." },
    { "gameKey": "MKDSupportJob#23.4", "hash": "B460ADB08BA7DE76", "target": "Phantom Necromancer" }
  ]
