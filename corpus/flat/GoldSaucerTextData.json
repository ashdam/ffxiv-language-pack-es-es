    { "gameKey": "GoldSaucerTextData#52", "hash": "60E7E85E69077756", "target": "Jarrones entregados" },
    { "gameKey": "GoldSaucerTextData#61", "hash": "9B419500ED2259E7", "target": "The Time of My Life" },
    { "gameKey": "GoldSaucerTextData#62", "hash": "A02D0C58F2FF6196", "target": "Súbete al escenario principal y memoriza la coreografía del gran número de baile." },
    { "gameKey": "GoldSaucerTextData#63", "hash": "5DA7F609BA7D6CB1", "target": "Memoriza la coreografía de los Lords and Ladies of the Dance y ejecuta diez movimientos o más a la señal y sin un solo fallo." },
    { "gameKey": "GoldSaucerTextData#64", "hash": "EAFA31257BA70C03", "target": "Primera estrofa" },
    { "gameKey": "GoldSaucerTextData#65", "hash": "85AA84002FCBFD1A", "target": "Segunda estrofa" },
    { "gameKey": "GoldSaucerTextData#66", "hash": "0D8FB4B3378C85FB", "target": "Tercera estrofa" },
    { "gameKey": "GoldSaucerTextData#67", "hash": "8BFDDDD2C857069F", "target": "Cuarta estrofa" },
    { "gameKey": "GoldSaucerTextData#68", "hash": "1B148750F424EB4B", "target": "Movimientos perfectos" },
    { "gameKey": "GoldSaucerTextData#71", "hash": "F1BCFE488286AB5C", "target": "Any Way the Wind Blows" },
    { "gameKey": "GoldSaucerTextData#72", "hash": "558CEE55B754815D", "target": "Súbete al escenario principal y mide tu ingenio contra Typhon─resoplador sin igual. ¿Aguantarás en la tarima hasta que se agote el tiempo o saldrás volando?" },
    { "gameKey": "GoldSaucerTextData#73", "hash": "BD7F39E18FE67D3D", "target": "Anticipa dónde se producirá la próxima erupción nasal de Typhon y desplázate a un punto donde creas que estarás a salvo." },
    { "gameKey": "GoldSaucerTextData#74", "hash": "492431748E8F0043", "target": "Resoplidos evitados" },
    { "gameKey": "GoldSaucerTextData#81", "hash": "FFBE01A11A731A5F", "target": "Skinchange We Can Believe In" },
    { "gameKey": "GoldSaucerTextData#82", "hash": "A9B2C0BFC23C323D", "target": "Un imp malvado ha adoptado la forma de un honrado cliente del Gold Saucer y se esconde en algún rincón del recinto. Localiza al doble exacto del cliente del GATE y aséstale una buena dosis de brightash." },
    { "gameKey": "GoldSaucerTextData#91", "hash": "D5E0D1B105C0F219", "target": "Cliffhanger" },
    { "gameKey": "GoldSaucerTextData#101", "hash": "56A899DA8BBEFF5C", "target": "Comprar un boleto de Mini Cactpot" },
