    { "gameKey": "GoldSaucerTextData#110", "hash": "84D84A7AAD4E841E", "target": "¡<if(gnum4,Bienvenida,Bienvenido)> al circuito de entrenamiento!" },
    { "gameKey": "GoldSaucerTextData#111", "hash": "BF96EA78D17D50F6", "target": "Sigue todas las instrucciones del instructor de carreras." },
    { "gameKey": "GoldSaucerTextData#112", "hash": "083C747FAFA061C5", "target": "¡Circuito de entrenamiento completado!" },
    { "gameKey": "GoldSaucerTextData#113", "hash": "44DDF474A61E236B", "target": "" },
    { "gameKey": "GoldSaucerTextData#114", "hash": "331032DD412E0D00", "target": "Acelerar." },
    { "gameKey": "GoldSaucerTextData#115", "hash": "B9B72CBD091A456E", "target": "Acelerar hasta agotar la resistencia." },
    { "gameKey": "GoldSaucerTextData#116", "hash": "7420BA74E4139502", "target": "Acelerar a máxima velocidad y después frenar." },
    { "gameKey": "GoldSaucerTextData#117", "hash": "A1B2E1AD8FF332E9", "target": "Girar." },
    { "gameKey": "GoldSaucerTextData#118", "hash": "D5BAA5E9CB636E76", "target": "Activar un panel mágico." },
    { "gameKey": "GoldSaucerTextData#119", "hash": "2381DFBA4F0A0797", "target": "Saltar." },
    { "gameKey": "GoldSaucerTextData#120", "hash": "F13C0DB98DE78C14", "target": "Abrir un cofre del tesoro." },
    { "gameKey": "GoldSaucerTextData#121", "hash": "45338633B4148BD3", "target": "Usar un objeto de carrera." },
    { "gameKey": "GoldSaucerTextData#131", "hash": "7A864D6C4FC26089", "target": "Las reglas del Mini Cactpot son sencillas. Primero, seleccione tres de los ocho números ocultos de su boleto. Después, elija una de las ocho líneas─vertical, horizontal o diagonal." },
    { "gameKey": "GoldSaucerTextData#132", "hash": "F1E5994A1E7CD945", "target": "Una vez elegida la línea, se descubren todos los números, y la suma de los tres de la línea que haya elegido determina su premio en MGP. ¡Así de sencillo!" },
    { "gameKey": "GoldSaucerTextData#133", "hash": "AB0CA2D93927EBE4", "target": "Ahora solo queda elegir un número de cuatro cifras. El número ganador se sorteará más adelante. Si la última cifra del suyo coincide con la del ganador, gana el cuarto premio. Si coinciden las dos últimas, el tercero; si las tres últimas, el segundo; y si coinciden todas, se lleva el premio gordo." },
