    { "gameKey": "BaseParam#19.2", "hash": "13D7C535E77A1366", "target": "Afecta a la cantidad de daño físico y mágico infligido y recibido, y también a los PV restaurados. Cuanto mayor sea el valor, más daño se inflige, más PV se restauran y menos daño se recibe. Solo se aplica cuando el rol es Tanque." },
    { "gameKey": "BaseParam#20.1", "hash": "F720BEFB7A5A0696", "target": "Ataque" },
    { "gameKey": "BaseParam#20.2", "hash": "2DBD71A0D4262110", "target": "Afecta a la cantidad de daño que infligen los ataques físicos. Cuanto mayor sea el valor, más daño se inflige." },
    { "gameKey": "BaseParam#21.1", "hash": "A4D2D9D27604F1FB", "target": "Defensa" },
    { "gameKey": "BaseParam#21.2", "hash": "32A52C6C58EDECC0", "target": "Afecta a la cantidad de daño que se recibe de los ataques físicos. Cuanto mayor sea el valor, menos daño se recibe." },
    { "gameKey": "BaseParam#22.1", "hash": "BEF8EE86262AD39C", "target": "Golpe directo" },
    { "gameKey": "BaseParam#22.2", "hash": "7354943AB7BF2CF8", "target": "Afecta a la frecuencia con la que tus ataques físicos y mágicos asestan golpes directos, que hacen algo más de daño que los normales. Cuanto mayor sea el valor, más a menudo serán directos tus golpes. Un valor alto también aumenta el daño de las acciones que garantizan un golpe directo." },
